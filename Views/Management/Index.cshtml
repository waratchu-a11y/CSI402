@{
    ViewData["Title"] = "จัดการระบบ";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var payments = (List<warat_0583_l005.Models.PaymentModel>)ViewBag.RecentPayments;
}

<div class="container py-4 py-lg-5">
    <section class="admin-hero mb-4">
        <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap position-relative z-1">
            <div>
                <span class="badge bg-warning text-dark rounded-pill px-3 py-1 mb-2 fw-semibold">
                    <i class="fa-solid fa-chart-line me-1"></i> ศูนย์รายงานและการจัดการ
                </span>
                <h1 class="h2 fw-bold mb-1">ภาพรวมผู้จัดการ</h1>
                <p class="mb-0 text-white-50">สรุปสถิติการดำเนินงาน ยอดรับสุทธิ และทางลัดการจัดการระบบ</p>
            </div>
            <div class="bg-white bg-opacity-10 border border-white border-opacity-25 rounded-4 px-4 py-3 text-end">
                <div class="small text-white-50">ยอดรับสุทธิจากรายการที่บันทึก</div>
                <div class="fs-3 fw-bold text-warning">฿@(((decimal)ViewBag.NetReceived).ToString("N2"))</div>
            </div>
        </div>
    </section>

    <div class="row g-3 g-lg-4 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card kpi-card h-100">
                <div class="card-body d-flex align-items-center gap-3 p-4">
                    <div class="kpi-icon bg-primary-subtle text-primary">
                        <i class="fa-solid fa-car-side fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">รถทั้งหมด</div>
                        <div class="fs-3 fw-bold">@ViewBag.CarCount</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card kpi-card h-100">
                <div class="card-body d-flex align-items-center gap-3 p-4">
                    <div class="kpi-icon bg-info-subtle text-info">
                        <i class="fa-solid fa-calendar-check fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">การจองทั้งหมด</div>
                        <div class="fs-3 fw-bold">@ViewBag.BookingCount</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card kpi-card h-100">
                <div class="card-body d-flex align-items-center gap-3 p-4">
                    <div class="kpi-icon bg-warning-subtle text-warning-emphasis">
                        <i class="fa-solid fa-spinner fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">รายการกำลังดำเนินการ</div>
                        <div class="fs-3 fw-bold">@ViewBag.ActiveBookingCount</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card kpi-card h-100">
                <div class="card-body d-flex align-items-center gap-3 p-4">
                    <div class="kpi-icon bg-success-subtle text-success">
                        <i class="fa-solid fa-users fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">ผู้ใช้งาน</div>
                        <div class="fs-3 fw-bold">@ViewBag.UserCount</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body p-4 d-flex flex-wrap gap-2 align-items-center justify-content-between">
            <span class="fw-bold text-secondary"><i class="fa-solid fa-bolt text-warning me-2"></i>เมนูด่วน</span>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Admin" asp-action="CarManagement" class="btn btn-primary"><i class="fa-solid fa-car me-1"></i>จัดการรถและราคา</a>
                <a asp-action="Promotions" class="btn btn-outline-primary"><i class="fa-solid fa-percent me-1"></i>จัดการโปรโมชั่น</a>
                <a asp-action="AddOnServices" class="btn btn-outline-success"><i class="fa-solid fa-puzzle-piece me-1"></i>จัดการบริการเสริม</a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Settings" class="btn btn-outline-dark"><i class="fa-solid fa-building-columns me-1"></i>ตั้งค่าบัญชีรับโอน</a>
                }
                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                {
                    <a asp-action="Users" class="btn btn-outline-dark"><i class="fa-solid fa-users-gear me-1"></i>ผู้ใช้และสิทธิ์</a>
                }
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h4 class="h5 fw-bold mb-0"><i class="fa-solid fa-receipt text-primary me-2"></i>รายการรับ-จ่ายล่าสุด</h4>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="px-4">วันเวลา</th>
                            <th>Booking</th>
                            <th>ประเภท</th>
                            <th>สถานะ</th>
                            <th class="text-end px-4">ยอด</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var payment in payments)
                    {
                        var statusBadge = payment.PaymentStatus switch
                        {
                            "verified" => "bg-success-subtle text-success",
                            "pending" => "bg-warning-subtle text-warning-emphasis",
                            "rejected" => "bg-danger-subtle text-danger",
                            _ => "bg-secondary-subtle text-secondary"
                        };
                        <tr>
                            <td class="px-4 text-muted small">@payment.CreatedAt.ToString("g")</td>
                            <td><strong>#@payment.BookingId</strong></td>
                            <td>@payment.PaymentType</td>
                            <td><span class="badge @statusBadge rounded-pill">@payment.PaymentStatus</span></td>
                            <td class="text-end px-4 fw-bold text-primary">฿@payment.Amount.ToString("N2")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
