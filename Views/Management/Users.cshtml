@model IEnumerable<warat_0583_l005.Models.UserModel>
@{
    ViewData["Title"] = "จัดการผู้ใช้งาน";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var roles = (string[])ViewBag.AvailableRoles;
}

<div class="container py-4 py-lg-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="h2 fw-bold mb-1"><i class="fa-solid fa-users-gear text-primary me-2"></i>จัดการผู้ใช้งานและสิทธิ์</h1>
            <p class="text-muted mb-0">ตรวจสอบบัญชีผู้ใช้งาน กำหนดบทบาทหน้าที่ และจัดการรหัสผ่าน</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="fa-solid fa-arrow-left me-1"></i>กลับภาพรวม
        </a>
    </div>
    @if (TempData["ManagementMessage"] is string message) { <div class="alert alert-success">@message</div> }
    @if (TempData["ManagementError"] is string error) { <div class="alert alert-danger">@error</div> }
    <div class="alert alert-info mb-4">
        <i class="fa-solid fa-shield-halved me-1"></i>
        ระบบไม่สามารถแสดงรหัสผ่านเดิมได้ เพราะจัดเก็บเป็นค่าแฮช หากต้องการเปลี่ยนให้ใช้ปุ่มตั้งรหัสใหม่
    </div>
    <div class="card">
        <div class="card-header fw-bold"><i class="fa-solid fa-users text-primary me-2"></i>รายชื่อผู้ใช้งานทั้งหมด (@Model.Count())</div>
        <div class="card-body p-0">
            <div class="table-responsive"><table class="table table-hover align-middle mb-0">
                <thead><tr><th class="px-4">ผู้ใช้</th><th>อีเมล</th><th>เบอร์โทร</th><th>สิทธิ์ / สถานะ</th><th class="pe-4">การจัดการ</th></tr></thead>
        <tbody>
        @foreach (var user in Model)
        {
            bool isAdmin = User.IsInRole("Admin");
            bool canResetPassword = isAdmin || user.Role is not ("Admin" or "Manager");
            var editFormId = $"editUserForm-{user.Id}";
            var resetFormId = $"resetPasswordForm-{user.Id}";
            <tr>
                <td>@user.Username (#@user.Id)</td><td>@user.Email</td><td>@user.Phone</td>
                <td>
                    @if (isAdmin)
                    {
                        <span>@user.Role / @(user.IsActive ? "ใช้งาน" : "ปิดใช้งาน")</span>
                    }
                    else
                    {
                        <form asp-action="UpdateUser" method="post" class="d-flex gap-2">
                            <input type="hidden" name="userId" value="@user.Id" />
                            <select name="role" class="form-select form-select-sm">
                                @foreach (var role in roles) { <option value="@role" selected="@(user.Role == role)">@role</option> }
                            </select>
                            <select name="isActive" class="form-select form-select-sm">
                                <option value="true" selected="@user.IsActive">ใช้งาน</option>
                                <option value="false" selected="@(!user.IsActive)">ปิดใช้งาน</option>
                            </select>
                            <button class="btn btn-sm btn-primary">บันทึก</button>
                        </form>
                    }
                </td>
                <td>
                    @if (isAdmin)
                    {
                        <button class="btn btn-sm btn-outline-primary text-nowrap mb-1" type="button"
                                data-bs-toggle="collapse" data-bs-target="#@editFormId"
                                aria-expanded="false" aria-controls="@editFormId">
                            <i class="fa-solid fa-pen-to-square me-1"></i>แก้ไขข้อมูล
                        </button>
                    }
                    @if (canResetPassword)
                    {
                        <button class="btn btn-sm btn-outline-warning text-nowrap" type="button"
                                data-bs-toggle="collapse" data-bs-target="#@resetFormId"
                                aria-expanded="false" aria-controls="@resetFormId">
                            <i class="fa-solid fa-key me-1"></i>ตั้งรหัสใหม่
                        </button>
                    }
                    @if (isAdmin)
                    {
                        <form asp-action="DeleteUser" method="post" class="d-inline"
                              data-confirm="ยืนยันลบบัญชี @user.Username หรือไม่? การลบไม่สามารถย้อนกลับได้">
                            <input type="hidden" name="userId" value="@user.Id" />
                            <button class="btn btn-sm btn-outline-danger text-nowrap mb-1"
                                    type="submit" disabled="@(user.Username == User.Identity?.Name)">
                                <i class="fa-solid fa-trash me-1"></i>ลบ
                            </button>
                        </form>
                    }
                    else if (!canResetPassword)
                    {
                        <span class="text-muted small">เฉพาะ Admin</span>
                    }
                    @if (canResetPassword)
                    {
                        <div class="collapse mt-2" id="@resetFormId">
                            <form asp-action="ResetUserPassword" method="post" class="card card-body p-3" style="min-width: 290px;">
                                <input type="hidden" name="userId" value="@user.Id" />
                                <label class="form-label small fw-semibold" for="newPassword-@user.Id">รหัสผ่านใหม่ (8–128 ตัว)</label>
                                <div class="input-group input-group-sm mb-2">
                                    <input id="newPassword-@user.Id" name="newPassword" type="password"
                                           class="form-control" autocomplete="new-password" minlength="8" maxlength="128" required />
                                    <button class="btn btn-outline-secondary" type="button"
                                            data-toggle-password="newPassword-@user.Id" aria-label="แสดงหรือซ่อนรหัสผ่าน">
                                        <i class="fa-solid fa-eye"></i>
                                    </button>
                                </div>
                                <label class="form-label small fw-semibold" for="confirmPassword-@user.Id">ยืนยันรหัสผ่านใหม่</label>
                                <div class="input-group input-group-sm mb-2">
                                    <input id="confirmPassword-@user.Id" name="confirmPassword" type="password"
                                           class="form-control" autocomplete="new-password" minlength="8" maxlength="128" required />
                                    <button class="btn btn-outline-secondary" type="button"
                                            data-toggle-password="confirmPassword-@user.Id" aria-label="แสดงหรือซ่อนรหัสผ่าน">
                                        <i class="fa-solid fa-eye"></i>
                                    </button>
                                </div>
                                <button class="btn btn-sm btn-warning fw-semibold" type="submit">บันทึกรหัสใหม่</button>
                            </form>
                        </div>
                    }
                </td>
            </tr>
            @if (isAdmin)
            {
                <tr>
                    <td colspan="5" class="p-0 border-0">
                        <div class="collapse" id="@editFormId">
                            <form asp-action="UpdateUserDetails" method="post" class="card card-body m-2">
                                <input type="hidden" name="userId" value="@user.Id" />
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label class="form-label" for="username-@user.Id">ชื่อผู้ใช้</label>
                                        <input id="username-@user.Id" name="username" value="@user.Username"
                                               class="form-control" maxlength="255" required />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label" for="email-@user.Id">อีเมล</label>
                                        <input id="email-@user.Id" name="email" type="email" value="@user.Email"
                                               class="form-control" maxlength="255" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label" for="phone-@user.Id">เบอร์โทร</label>
                                        <input id="phone-@user.Id" name="phone" value="@user.Phone"
                                               class="form-control" maxlength="50" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label" for="gender-@user.Id">เพศ</label>
                                        <input id="gender-@user.Id" name="gender" value="@user.Gender"
                                               class="form-control" maxlength="50" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label" for="idCard-@user.Id">เลขบัตรประชาชน</label>
                                        <input id="idCard-@user.Id" name="idCard" value="@user.IdCard"
                                               class="form-control" maxlength="13" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label" for="driverLicense-@user.Id">เลขใบขับขี่</label>
                                        <input id="driverLicense-@user.Id" name="driverLicense" value="@user.DriverLicense"
                                               class="form-control" maxlength="20" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label" for="role-@user.Id">สิทธิ์</label>
                                        <select id="role-@user.Id" name="role" class="form-select">
                                            @foreach (var role in roles) { <option value="@role" selected="@(user.Role == role)">@role</option> }
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label" for="isActive-@user.Id">สถานะ</label>
                                        <select id="isActive-@user.Id" name="isActive" class="form-select">
                                            <option value="true" selected="@user.IsActive">ใช้งาน</option>
                                            <option value="false" selected="@(!user.IsActive)">ปิดใช้งาน</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label" for="registerDate-@user.Id">วันที่สมัคร</label>
                                        <input id="registerDate-@user.Id" name="registerDate" type="date"
                                               value="@user.RegisterDate.ToString("yyyy-MM-dd")" class="form-control" required />
                                    </div>
                                </div>
                                <div class="mt-3">
                                    <button class="btn btn-primary" type="submit">บันทึกข้อมูล</button>
                                </div>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table></div>
    </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('[data-toggle-password]').forEach(button => {
            button.addEventListener('click', () => {
                const input = document.getElementById(button.dataset.togglePassword);
                if (!input) return;
                input.type = input.type === 'password' ? 'text' : 'password';
                button.querySelector('i').classList.toggle('fa-eye');
                button.querySelector('i').classList.toggle('fa-eye-slash');
            });
        });
    </script>
}
