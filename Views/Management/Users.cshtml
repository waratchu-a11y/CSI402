@model IEnumerable<warat_0583_l005.Models.UserModel>
@{
    ViewData["Title"] = "จัดการผู้ใช้งาน";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var roles = (string[])ViewBag.AvailableRoles;
}

<div class="container my-5">
    <h2 class="fw-bold mb-3">จัดการผู้ใช้งานและสิทธิ์</h2>
    @if (TempData["ManagementMessage"] is string message) { <div class="alert alert-success">@message</div> }
    @if (TempData["ManagementError"] is string error) { <div class="alert alert-danger">@error</div> }
    <div class="alert alert-info">
        <i class="fa-solid fa-shield-halved me-1"></i>
        ระบบไม่สามารถแสดงรหัสผ่านเดิมได้ เพราะจัดเก็บเป็นค่าแฮช หากลืมรหัสผ่านให้ตั้งรหัสใหม่แทน
    </div>
    <div class="table-responsive"><table class="table align-middle">
        <thead><tr><th>ผู้ใช้</th><th>อีเมล</th><th>เบอร์โทร</th><th>สิทธิ์ / สถานะ</th><th>รหัสผ่าน</th></tr></thead>
        <tbody>
        @foreach (var user in Model)
        {
            bool canResetPassword = User.IsInRole("Admin") || user.Role is not ("Admin" or "Manager");
            <tr>
                <td>@user.Username (#@user.Id)</td><td>@user.Email</td><td>@user.Phone</td>
                <td>
                    <form asp-action="UpdateUser" method="post" class="d-flex gap-2">
                        <input type="hidden" name="userId" value="@user.Id" />
                        <select name="role" class="form-select form-select-sm">
                            @foreach (var role in roles) { <option value="@role" selected="@(user.Role == role)">@role</option> }
                        </select>
                        <select name="isActive" class="form-select form-select-sm">
                            <option value="true" selected="@user.IsActive">ใช้งาน</option>
                            <option value="false" selected="@(!user.IsActive)">ปิดใช้งาน</option>
                        </select>
                        <button class="btn btn-sm btn-primary">บันทึก</button>
                    </form>
                </td>
                <td>
                    @if (canResetPassword)
                    {
                        var resetFormId = $"resetPasswordForm-{user.Id}";
                        <button class="btn btn-sm btn-outline-warning text-nowrap" type="button"
                                data-bs-toggle="collapse" data-bs-target="#@resetFormId"
                                aria-expanded="false" aria-controls="@resetFormId">
                            <i class="fa-solid fa-key me-1"></i>ตั้งรหัสใหม่
                        </button>
                        <div class="collapse mt-2" id="@resetFormId">
                            <form asp-action="ResetUserPassword" method="post" class="card card-body p-3" style="min-width: 290px;">
                                <input type="hidden" name="userId" value="@user.Id" />
                                <label class="form-label small fw-semibold" for="newPassword-@user.Id">รหัสผ่านใหม่ (8–128 ตัว)</label>
                                <div class="input-group input-group-sm mb-2">
                                    <input id="newPassword-@user.Id" name="newPassword" type="password"
                                           class="form-control" autocomplete="new-password" minlength="8" maxlength="128" required />
                                    <button class="btn btn-outline-secondary" type="button"
                                            data-toggle-password="newPassword-@user.Id" aria-label="แสดงหรือซ่อนรหัสผ่าน">
                                        <i class="fa-solid fa-eye"></i>
                                    </button>
                                </div>
                                <label class="form-label small fw-semibold" for="confirmPassword-@user.Id">ยืนยันรหัสผ่านใหม่</label>
                                <div class="input-group input-group-sm mb-2">
                                    <input id="confirmPassword-@user.Id" name="confirmPassword" type="password"
                                           class="form-control" autocomplete="new-password" minlength="8" maxlength="128" required />
                                    <button class="btn btn-outline-secondary" type="button"
                                            data-toggle-password="confirmPassword-@user.Id" aria-label="แสดงหรือซ่อนรหัสผ่าน">
                                        <i class="fa-solid fa-eye"></i>
                                    </button>
                                </div>
                                <button class="btn btn-sm btn-warning fw-semibold" type="submit">บันทึกรหัสใหม่</button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <span class="text-muted small">เฉพาะ Admin</span>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table></div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('[data-toggle-password]').forEach(button => {
            button.addEventListener('click', () => {
                const input = document.getElementById(button.dataset.togglePassword);
                if (!input) return;
                input.type = input.type === 'password' ? 'text' : 'password';
                button.querySelector('i').classList.toggle('fa-eye');
                button.querySelector('i').classList.toggle('fa-eye-slash');
            });
        });
    </script>
}
