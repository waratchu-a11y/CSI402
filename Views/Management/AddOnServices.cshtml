@model IEnumerable<warat_0583_l005.Models.AddOnServiceModel>
@{
    ViewData["Title"] = "จัดการบริการเสริม";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-4 py-lg-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="h2 fw-bold mb-1"><i class="fa-solid fa-puzzle-piece text-info me-2"></i>จัดการบริการเสริม</h1>
            <p class="text-muted mb-0">กำหนดราคาและสถานะการเปิดให้บริการเสริมสำหรับการเช่ารถ</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="fa-solid fa-arrow-left me-1"></i>กลับภาพรวม
        </a>
    </div>

    @if (TempData["ManagementMessage"] is string message) { <div class="alert alert-success">@message</div> }

    <div class="card">
        <div class="card-header fw-bold"><i class="fa-solid fa-list-check text-primary me-2"></i>รายการบริการเสริม (@Model.Count())</div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="px-4">รหัส</th>
                            <th>บริการ</th>
                            <th>ราคา / วัน (บาท)</th>
                            <th>สถานะ</th>
                            <th class="text-end pe-4">จัดการ</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var service in Model)
                    {
                        <tr>
                            <td class="px-4"><span class="badge bg-light text-dark border">@service.ServiceCode</span></td>
                            <td><input form="addon-@service.ServiceId" name="serviceName" value="@service.ServiceName" maxlength="150" class="form-control form-control-sm" required /></td>
                            <td style="width: 170px;"><input form="addon-@service.ServiceId" name="pricePerDay" type="number" min="0" step="0.01" value="@service.PricePerDay" class="form-control form-control-sm" required /></td>
                            <td style="width: 140px;">
                                <select form="addon-@service.ServiceId" name="isActive" class="form-select form-select-sm">
                                    <option value="true" selected="@service.IsActive">เปิดใช้งาน</option>
                                    <option value="false" selected="@(!service.IsActive)">ปิดใช้งาน</option>
                                </select>
                            </td>
                            <td class="text-end pe-4">
                                <form id="addon-@service.ServiceId" asp-action="UpdateAddOn" method="post">
                                    <input type="hidden" name="serviceId" value="@service.ServiceId" />
                                    <button class="btn btn-sm btn-primary"><i class="fa-solid fa-floppy-disk me-1"></i>บันทึก</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
