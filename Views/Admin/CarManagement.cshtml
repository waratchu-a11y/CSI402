@model IEnumerable<warat_0583_l005.Models.CarModel>
@{
    ViewData["Title"] = "จัดการข้อมูลรถเช่า - Admin";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark m-0"><i class="fa-solid fa-car text-primary me-2"></i> จัดการข้อมูลรถเช่า</h2>
            <p class="text-muted m-0 mt-1">เพิ่ม แก้ไข ลบ และเปลี่ยนสถานะรถยนต์ในระบบ</p>
        </div>
        <div>
            <a href="~/Admin/Index" class="btn btn-outline-secondary me-2 fw-bold" style="border-radius: 10px;">
                <i class="fa-solid fa-arrow-left me-1"></i> กลับ Dashboard
            </a>
            <button class="btn btn-success fw-bold px-4" data-bs-toggle="modal" data-bs-target="#addCarModal" style="border-radius: 10px;">
                <i class="fa-solid fa-plus me-1"></i> เพิ่มรถยนต์ใหม่
            </button>
        </div>
    </div>

    @if (TempData["CarSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["CarSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["CarError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["CarError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- ตารางแสดงรายการรถ -->
    <div class="card shadow-sm border-0" style="border-radius: 15px; overflow: hidden;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle m-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="py-3 px-4">รูปภาพ</th>
                            <th class="py-3">ชื่อรุ่นรถยนต์</th>
                            <th class="py-3">รายละเอียด / สเปก</th>
                            <th class="py-3">ราคา / วัน</th>
                            <th class="py-3 text-center">สถานะ</th>
                            <th class="py-3 text-center">จัดการ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var car in Model)
                            {
                                <tr>
                                    <td class="px-4 py-3">
                                        <img src="@car.ImageUrl" alt="@car.CarName" class="rounded border" style="width: 90px; height: 60px; object-fit: cover;" onerror="this.src='https://via.placeholder.com/90x60?text=No+Image';" />
                                    </td>
                                    <td class="fw-bold text-dark">@car.CarName</td>
                                    <td class="text-muted small">
                                        @car.Details
                                        <span class="d-block">@(car.TransmissionType == "automatic" ? "เกียร์อัตโนมัติ" : "เกียร์ธรรมดา") / @(car.Seats ?? 0) ที่นั่ง</span>
                                    </td>
                                    <td class="fw-bold text-primary">฿@car.PricePerDay.ToString("N0")</td>
                                    <td class="text-center">
                                        @if (car.Status == "ว่าง")
                                        {
                                            <span class="badge bg-success px-3 py-2 rounded-pill">ว่าง / พร้อมเช่า</span>
                                        }
                                        else if (car.Status == "ไม่ว่าง")
                                        {
                                            <span class="badge bg-danger px-3 py-2 rounded-pill">ไม่ว่าง (ถูกจอง)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">@car.Status</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-outline-primary fw-bold me-1"
                                                data-edit-target="edit-car-@car.CarId">
                                            <i class="fa-solid fa-pen-to-square"></i> แก้ไข
                                        </button>
                                        <form asp-action="DeleteCar" method="post" class="d-inline" onsubmit="return confirm('ยืนยันลบรถคันนี้หรือไม่?');">
                                            <input type="hidden" name="id" value="@car.CarId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger fw-bold"><i class="fa-solid fa-trash"></i> ลบ</button>
                                        </form>
                                    </td>
                                </tr>
                                <tr id="edit-car-@car.CarId" class="d-none bg-light">
                                    <td colspan="6" class="p-4">
                                        <form asp-action="EditCar" method="post">
                                            <input type="hidden" name="CarId" value="@car.CarId" />
                                            <div class="row g-3">
                                                <div class="col-md-3">
                                                    <label class="form-label fw-bold small">ชื่อรุ่นรถยนต์</label>
                                                    <input type="text" name="CarName" value="@car.CarName" class="form-control" maxlength="150" required />
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label fw-bold small">รายละเอียด / สเปก</label>
                                                    <input type="text" name="Details" value="@car.Details" class="form-control" maxlength="255" required />
                                                </div>
                                                <div class="col-md-2">
                                                    <label class="form-label fw-bold small">ระบบเกียร์</label>
                                                    <select name="TransmissionType" class="form-select" required>
                                                        <option value="automatic" selected="@(car.TransmissionType == "automatic")">อัตโนมัติ</option>
                                                        <option value="manual" selected="@(car.TransmissionType == "manual")">ธรรมดา</option>
                                                    </select>
                                                </div>
                                                <div class="col-md-1">
                                                    <label class="form-label fw-bold small">ที่นั่ง</label>
                                                    <input type="number" name="Seats" value="@car.Seats" class="form-control" min="2" max="12" required />
                                                </div>
                                                <div class="col-md-1">
                                                    <label class="form-label fw-bold small">ราคาต่อวัน</label>
                                                    <input type="number" name="PricePerDay" value="@car.PricePerDay" class="form-control" min="0.01" step="0.01" required />
                                                </div>
                                                <div class="col-md-2">
                                                    <label class="form-label fw-bold small">สถานะ</label>
                                                    <select name="Status" class="form-select" required>
                                                        <option value="ว่าง" selected="@(car.Status == "ว่าง")">ว่าง</option>
                                                        <option value="ไม่ว่าง" selected="@(car.Status == "ไม่ว่าง")">ไม่ว่าง</option>
                                                        <option value="อยู่ระหว่างซ่อม" selected="@(car.Status == "อยู่ระหว่างซ่อม")">อยู่ระหว่างซ่อม</option>
                                                    </select>
                                                </div>
                                                <div class="col-md-9">
                                                    <label class="form-label fw-bold small">ลิงก์รูปภาพ</label>
                                                    <input type="text" name="ImageUrl" value="@car.ImageUrl" class="form-control" maxlength="255" required />
                                                </div>
                                                <div class="col-md-3 d-flex align-items-end gap-2">
                                                    <button type="submit" class="btn btn-primary fw-bold">
                                                        <i class="fa-solid fa-floppy-disk me-1"></i>บันทึก
                                                    </button>
                                                    <button type="button" class="btn btn-outline-secondary" data-edit-target="edit-car-@car.CarId">
                                                        ยกเลิก
                                                    </button>
                                                </div>
                                            </div>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-car-rear fa-3x mb-3 text-secondary"></i>
                                    <h5>ยังไม่มีข้อมูลรถยนต์ในระบบ</h5>
                                    <p class="small m-0">กดปุ่ม "เพิ่มรถยนต์ใหม่" ด้านบนเพื่อเพิ่มข้อมูลรถยนต์คันแรก</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal เพิ่มรถยนต์ -->
<div class="modal fade" id="addCarModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 15px;">
            <div class="modal-header bg-primary text-white" style="border-radius: 15px 15px 0 0;">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-car me-2"></i> เพิ่มรถยนต์ใหม่</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddCar" method="post">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small">ชื่อรุ่นรถยนต์</label>
                        <input type="text" name="CarName" class="form-control" placeholder="เช่น Toyota Yaris Ativ" required />
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-bold small">ราคาต่อวัน (บาท)</label>
                            <input type="number" name="PricePerDay" class="form-control" placeholder="890" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold small">จำนวนที่นั่ง</label>
                            <input type="number" name="Seats" class="form-control" min="2" max="12" placeholder="5" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold small">ระบบเกียร์</label>
                            <select name="TransmissionType" class="form-select" required>
                                <option value="automatic">อัตโนมัติ</option>
                                <option value="manual">ธรรมดา</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold small">สถานะ</label>
                            <select name="Status" class="form-select">
                                <option value="ว่าง">ว่าง</option>
                                <option value="ไม่ว่าง">ไม่ว่าง</option>
                                <option value="อยู่ระหว่างซ่อม">อยู่ระหว่างซ่อม</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small">ลิงก์รูปภาพ (Image URL)</label>
                        <input type="text" name="ImageUrl" class="form-control" placeholder="https://..." required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">รายละเอียดสเปกรถ</label>
                        <input type="text" name="Details" class="form-control" placeholder="เช่น 4 ที่นั่ง | อัตโนมัติ | 1.2L" required />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="submit" class="btn btn-success fw-bold px-4">บันทึกข้อมูลรถ</button>
                </div>
            </form>
        </div>
    </div>

    @section Scripts {
        <script>
            document.addEventListener('click', function (event) {
                const button = event.target.closest('[data-edit-target]');
                if (!button) return;

                const row = document.getElementById(button.dataset.editTarget);
                if (row) row.classList.toggle('d-none');
            });
        </script>
    }
</div>