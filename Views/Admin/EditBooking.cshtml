@model warat_0583_l005.Models.BookingModel
@using warat_0583_l005.Models
@using warat_0583_l005.Services
@{
    ViewData["Title"] = "แก้ไขรายการจอง";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var cars = (List<CarModel>)ViewBag.Cars;
    bool hasPickupDate = CarAvailability.TryParseDate(Model.PickupDate, out var pickupDate);
    var pickupValue = hasPickupDate ? pickupDate.ToString("yyyy-MM-dd") : "";
    var returnValue = Model.ReturnDate?.ToString("yyyy-MM-dd") ??
        (hasPickupDate ? pickupDate.AddDays(Model.RentalDays).ToString("yyyy-MM-dd") : "");
    var statusLabel = Model.BookingStatus switch
    {
        "pending_payment" => "รอชำระมัดจำ",
        "payment_rejected" => "ชำระเงินไม่ผ่าน",
        _ => Model.BookingStatus
    };
}

@section Styles {
    <style>
        .booking-edit-page {
            max-width: 1180px;
        }

        .booking-edit-hero {
            position: relative;
            overflow: hidden;
            border-radius: 22px;
            padding: clamp(1.5rem, 4vw, 2.5rem);
            color: #fff;
            background: linear-gradient(120deg, #155bd5 0%, #0879ed 55%, #11a9d2 100%);
            box-shadow: 0 16px 38px rgba(13, 110, 253, .17);
        }

        .booking-edit-hero::after {
            content: "";
            position: absolute;
            width: 280px;
            height: 280px;
            right: -80px;
            top: -150px;
            border: 1px solid rgba(255,255,255,.2);
            border-radius: 50%;
            box-shadow: 0 0 0 35px rgba(255,255,255,.06), 0 0 0 70px rgba(255,255,255,.04);
            pointer-events: none;
        }

        .booking-edit-hero-content {
            position: relative;
            z-index: 1;
        }

        .booking-edit-hero .eyebrow {
            color: rgba(255,255,255,.75);
            font-size: .78rem;
            font-weight: 500;
            letter-spacing: .12em;
        }

        .booking-edit-hero .booking-ref {
            color: #fff;
            opacity: .76;
        }

        .booking-edit-panel {
            height: 100%;
            background: #fff;
            border: 1px solid #e8edf5;
            border-radius: 18px;
            box-shadow: 0 8px 26px rgba(31, 45, 61, .06);
        }

        .booking-edit-panel .panel-header {
            border-bottom: 1px solid #edf0f5;
            padding: 1.25rem 1.5rem;
        }

        .booking-edit-panel .panel-body {
            padding: 1.5rem;
        }

        .booking-edit-page .form-label {
            color: #344054;
            font-size: .92rem;
            font-weight: 500;
            margin-bottom: .45rem;
        }

        .booking-edit-page .form-control,
        .booking-edit-page .form-select {
            min-height: 46px;
            border-color: #dce3ed;
            border-radius: 10px;
        }

        .booking-edit-page .form-control:focus,
        .booking-edit-page .form-select:focus {
            border-color: #77aaff;
            box-shadow: 0 0 0 .2rem rgba(13, 110, 253, .12);
        }

        .booking-summary-value {
            font-size: 1.55rem;
            font-weight: 600;
            letter-spacing: -.02em;
        }

        .booking-summary-line + .booking-summary-line {
            border-top: 1px solid #edf0f5;
            margin-top: 1rem;
            padding-top: 1rem;
        }

        .booking-route {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            gap: .6rem;
        }

        .booking-route-location {
            overflow-wrap: anywhere;
        }

        @@media (max-width: 575.98px) {
            .booking-edit-panel .panel-header,
            .booking-edit-panel .panel-body {
                padding: 1.1rem;
            }

            .booking-edit-hero {
                border-radius: 17px;
            }
        }
    </style>
}

<div class="container booking-edit-page py-4 py-lg-5">
    <section class="booking-edit-hero mb-4">
        <div class="booking-edit-hero-content d-flex justify-content-between align-items-center flex-wrap gap-4">
            <div>
                <div class="eyebrow text-uppercase mb-2">จัดการรายการจอง</div>
                <h1 class="h2 fw-bold mb-2">แก้ไขรายการจอง <span class="booking-ref">#BK-@Model.BookingId</span></h1>
                <div class="d-flex align-items-center flex-wrap gap-2 text-white-50">
                    <span><i class="fa-solid fa-user me-1"></i>@Model.UserId</span>
                    <span class="d-none d-sm-inline">·</span>
                    <span class="badge rounded-pill bg-warning text-dark px-3 py-2">@statusLabel</span>
                </div>
            </div>
            <a asp-action="Bookings" asp-route-userId="@Model.UserId" class="btn btn-light rounded-pill px-4 fw-semibold">
                <i class="fa-solid fa-arrow-left me-2"></i>กลับรายการจอง
            </a>
        </div>
    </section>

    @if (TempData["AdminBookingError"] is string error)
    {
        <div class="alert alert-danger border-0 rounded-3 shadow-sm">
            <i class="fa-solid fa-circle-exclamation me-2"></i>@error
        </div>
    }

    <div class="alert alert-warning border-0 rounded-3 d-flex align-items-start gap-2 mb-4">
        <i class="fa-solid fa-circle-info mt-1"></i>
        <div>
            <strong>โปรดตรวจสอบก่อนบันทึก</strong>
            <div class="small">การเปลี่ยนรถหรือวันเช่าจะคำนวณราคาและมัดจำใหม่ตามราคารถปัจจุบัน ระบบจะตรวจสอบคิวรถซ้ำให้อัตโนมัติ</div>
        </div>
    </div>

    <div class="row g-4 align-items-start">
        <div class="col-lg-8">
            <section class="booking-edit-panel">
                <div class="panel-header d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-primary-subtle text-primary d-flex align-items-center justify-content-center"
                         style="width: 46px; height: 46px;">
                        <i class="fa-solid fa-calendar-days fs-5"></i>
                    </div>
                    <div>
                        <h2 class="h5 fw-bold mb-1">ข้อมูลรถและกำหนดการ</h2>
                        <p class="small text-muted mb-0">กรอกข้อมูลใหม่ให้ครบก่อนบันทึก</p>
                    </div>
                </div>
                <div class="panel-body">
                    <form asp-action="EditBooking" method="post">
                        <input type="hidden" name="id" value="@Model.BookingId" />
                        <div class="row g-3">
                            <div class="col-12">
                                <label for="carId" class="form-label">รถที่จอง</label>
                                <select id="carId" name="carId" class="form-select" required>
                                    @foreach (var car in cars)
                                    {
                                        <option value="@car.CarId" selected="@(car.CarId == Model.CarId)">
                                            @car.CarName — ฿@car.PricePerDay.ToString("N2")/วัน · @car.Status
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label for="pickupDate" class="form-label">วันที่รับรถ</label>
                                <input id="pickupDate" name="pickupDate" type="date" class="form-control" value="@pickupValue" required />
                            </div>
                            <div class="col-md-6">
                                <label for="returnDate" class="form-label">วันที่คืนรถ</label>
                                <input id="returnDate" name="returnDate" type="date" class="form-control" value="@returnValue" required />
                            </div>
                            <div class="col-md-6">
                                <label for="pickupTime" class="form-label">เวลารับรถ</label>
                                <input id="pickupTime" name="pickupTime" type="time" class="form-control" value="@Model.PickupTime?.ToString(@"hh\:mm")" required />
                            </div>
                            <div class="col-md-6">
                                <label for="returnTime" class="form-label">เวลาคืนรถ</label>
                                <input id="returnTime" name="returnTime" type="time" class="form-control" value="@Model.ReturnTime?.ToString(@"hh\:mm")" required />
                            </div>
                            <div class="col-md-6">
                                <label for="pickupLocation" class="form-label">จุดรับรถ</label>
                                <input id="pickupLocation" name="pickupLocation" class="form-control" maxlength="150" value="@Model.PickupLocation" required />
                            </div>
                            <div class="col-md-6">
                                <label for="returnLocation" class="form-label">จุดคืนรถ</label>
                                <input id="returnLocation" name="returnLocation" class="form-control" maxlength="150" value="@Model.ReturnLocation" required />
                            </div>
                        </div>
                        <div class="d-flex justify-content-end gap-2 border-top mt-4 pt-4">
                            <a asp-action="Bookings" asp-route-userId="@Model.UserId" class="btn btn-light rounded-pill px-4">ยกเลิก</a>
                            <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold">
                                <i class="fa-solid fa-floppy-disk me-2"></i>บันทึกการแก้ไข
                            </button>
                        </div>
                    </form>
                </div>
            </section>
        </div>

        <aside class="col-lg-4">
            <section class="booking-edit-panel mb-4">
                <div class="panel-header">
                    <h2 class="h6 fw-bold mb-0"><i class="fa-solid fa-receipt text-primary me-2"></i>สรุปรายการปัจจุบัน</h2>
                </div>
                <div class="panel-body">
                    <div class="booking-summary-line pt-0 mt-0 border-0">
                        <div class="small text-muted mb-1">รถที่จอง</div>
                        <div class="fw-semibold">@Model.CarModel</div>
                    </div>
                    <div class="booking-summary-line">
                        <div class="small text-muted mb-2">จุดรับ–คืนรถ</div>
                        <div class="booking-route">
                            <span class="booking-route-location fw-medium">@Model.PickupLocation</span>
                            <i class="fa-solid fa-arrow-right text-primary"></i>
                            <span class="booking-route-location fw-medium text-end">@Model.ReturnLocation</span>
                        </div>
                    </div>
                    <div class="booking-summary-line">
                        <div class="small text-muted mb-1">ระยะเวลาเช่า</div>
                        <div class="fw-semibold">@Model.RentalDays วัน</div>
                    </div>
                    <div class="booking-summary-line">
                        <div class="small text-muted mb-1">ยอดรวมปัจจุบัน</div>
                        <div class="booking-summary-value text-primary">฿@Model.TotalPrice.ToString("N2")</div>
                    </div>
                    <div class="booking-summary-line">
                        <div class="small text-muted mb-1">มัดจำปัจจุบัน</div>
                        <div class="fw-semibold">฿@Model.DepositAmount.ToString("N2")</div>
                    </div>
                </div>
            </section>
            <div class="small text-muted px-2">
                <i class="fa-solid fa-shield-halved text-success me-1"></i>
                แก้ไขได้เฉพาะรายการที่ยังไม่มีการชำระเงินรอตรวจสอบหรือยืนยันแล้ว
            </div>
        </aside>
    </div>
</div>
