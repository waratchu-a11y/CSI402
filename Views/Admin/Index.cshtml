@model warat_0583_l005.ViewModels.AdminDashboardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "ภาพรวมระบบ";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-4 py-lg-5">
    <section class="rounded-4 p-4 p-lg-5 mb-4 text-white shadow"
             style="background: linear-gradient(115deg, #1173ed, #10b9dc);">
        <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap">
            <div>
                <span class="badge badge-motion rounded-pill bg-warning text-dark px-3 py-2 mb-3">
                    <i class="fa-solid fa-shield-halved me-1"></i> ระบบจัดการหลังบ้าน
                </span>
                <h1 class="h2 fw-bold mb-2">ยินดีต้อนรับ, @Model.AdminName</h1>
                <p class="mb-0 text-white-50">จัดการการเช่ารถและติดตามภาพรวมระบบได้จากที่นี่</p>
            </div>
            <a asp-controller="Home" asp-action="Indexcustomer" class="btn btn-warning rounded-pill px-4 fw-semibold">
                <i class="fa-solid fa-arrow-up-right-from-square me-2"></i>ดูหน้าเว็บไซต์
            </a>
        </div>
    </section>

    <div class="row g-3 g-lg-4 mb-4">
        <div class="col-sm-6 col-xl-4">
            <div class="card h-100">
                <div class="card-body d-flex align-items-center gap-3 p-4">
                    <div class="rounded-3 bg-primary-subtle text-primary d-flex align-items-center justify-content-center"
                         style="width: 56px; height: 56px;">
                        <i class="fa-solid fa-sack-dollar fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">ยอดค่าเช่าที่รับชำระแล้ว</div>
                        <div class="fs-3 fw-bold">฿@Model.TotalSales.ToString("N0")</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-4">
            <div class="card h-100">
                <div class="card-body d-flex align-items-center gap-3 p-4">
                    <div class="rounded-3 bg-success-subtle text-success d-flex align-items-center justify-content-center"
                         style="width: 56px; height: 56px;">
                        <i class="fa-solid fa-chart-line fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">ยอดค่าเช่าเดือนนี้</div>
                        <div class="fs-3 fw-bold">฿@Model.CurrentMonthSales.ToString("N0")</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-4">
            <div class="card h-100">
                <div class="card-body d-flex align-items-center gap-3 p-4">
                    <div class="rounded-3 bg-warning-subtle text-warning-emphasis d-flex align-items-center justify-content-center"
                         style="width: 56px; height: 56px;">
                        <i class="fa-solid fa-calendar-check fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">รายการจองทั้งหมด</div>
                        <div class="fs-3 fw-bold">@Model.TotalBookings</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-4">
            <div class="card h-100">
                <div class="card-body d-flex align-items-center gap-3 p-4">
                    <div class="rounded-3 bg-danger-subtle text-danger d-flex align-items-center justify-content-center"
                         style="width: 56px; height: 56px;">
                        <i class="fa-solid fa-hourglass-half fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">รายการชำระเงินรอตรวจสอบ</div>
                        <div class="fs-3 fw-bold">@Model.PendingPayments</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-4">
            <div class="card h-100">
                <div class="card-body d-flex align-items-center gap-3 p-4">
                    <div class="rounded-3 bg-info-subtle text-info d-flex align-items-center justify-content-center"
                         style="width: 56px; height: 56px;">
                        <i class="fa-solid fa-users fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">ผู้ใช้งานทั้งหมด</div>
                        <div class="fs-3 fw-bold">@Model.TotalUsers</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-4">
            <div class="card h-100">
                <div class="card-body d-flex align-items-center gap-3 p-4">
                    <div class="rounded-3 bg-secondary-subtle text-secondary d-flex align-items-center justify-content-center"
                         style="width: 56px; height: 56px;">
                        <i class="fa-solid fa-car-side fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">รถในระบบ</div>
                        <div class="fs-3 fw-bold">@Model.TotalCars</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <section class="mb-4">
        <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-3">
            <div>
                <h2 class="h4 fw-bold mb-1"><i class="fa-solid fa-chart-column text-primary me-2"></i>สรุปยอดขาย</h2>
                <p class="text-muted small mb-0">คำนวณจากยอดค่าเช่าที่ฝ่ายการเงินยืนยันแล้ว ไม่รวมเงินมัดจำและรายการที่รอตรวจสอบ</p>
            </div>
            <a asp-controller="Management" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                <i class="fa-solid fa-file-invoice-dollar me-1"></i>ดูรายงานการเงิน
            </a>
        </div>
        <div class="row g-3">
            <div class="col-12">
                <div class="card">
                    <div class="card-body p-4">
                        <h3 class="h6 fw-bold mb-3">ยอดขายรายเดือน (6 เดือนล่าสุด)</h3>
                        <div style="height: 320px;">
                            <canvas id="monthlySalesChart" role="img" aria-label="กราฟยอดขายรายเดือน"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="card h-100">
                    <div class="card-body p-4">
                        <h3 class="h6 fw-bold mb-3">รถทำรายได้สูงสุด 5 อันดับ</h3>
                        <div style="height: 300px;">
                            <canvas id="topCarsChart" role="img" aria-label="กราฟยอดขายแยกตามรุ่นรถ"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="card h-100">
                    <div class="card-body p-4">
                        <h3 class="h6 fw-bold mb-3">สถานะรายการจอง</h3>
                        <div style="height: 300px;">
                            <canvas id="bookingStatusChart" role="img" aria-label="กราฟสัดส่วนสถานะการจอง"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="card">
        <div class="card-body p-4 p-lg-5">
            <div class="mb-4">
                <h2 class="h4 fw-bold mb-1"><i class="fa-solid fa-sliders text-primary me-2"></i>เมนูจัดการระบบ</h2>
                <p class="text-muted mb-0">เลือกส่วนที่ต้องการดูแลหรือจัดการ</p>
            </div>
            <div class="row g-3">
                <div class="col-sm-6 col-lg-4">
                    <a asp-controller="Admin" asp-action="CarManagement" class="btn btn-outline-primary rounded-3 w-100 py-3">
                        <i class="fa-solid fa-car me-2"></i>จัดการข้อมูลรถเช่า
                    </a>
                </div>
                <div class="col-sm-6 col-lg-4">
                    <a asp-controller="Admin" asp-action="Bookings" class="btn btn-outline-primary rounded-3 w-100 py-3">
                        <i class="fa-solid fa-calendar-check me-2"></i>รายการจองของลูกค้า
                    </a>
                </div>
                <div class="col-sm-6 col-lg-4">
                    <a asp-controller="Management" asp-action="Index" class="btn btn-outline-success rounded-3 w-100 py-3">
                        <i class="fa-solid fa-chart-pie me-2"></i>สรุปยอดขาย
                    </a>
                </div>
                <div class="col-sm-6 col-lg-4">
                    <a asp-controller="Management" asp-action="Promotions" class="btn btn-outline-danger rounded-3 w-100 py-3">
                        <i class="fa-solid fa-percent me-2"></i>จัดการโปรโมชั่น
                    </a>
                </div>
                <div class="col-sm-6 col-lg-4">
                    <a asp-controller="Management" asp-action="AddOnServices" class="btn btn-outline-info rounded-3 w-100 py-3">
                        <i class="fa-solid fa-puzzle-piece me-2"></i>บริการเสริม
                    </a>
                </div>
                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                {
                    <div class="col-sm-6 col-lg-4">
                        <a asp-controller="Management" asp-action="Users" class="btn btn-outline-secondary rounded-3 w-100 py-3">
                            <i class="fa-solid fa-user-group me-2"></i>ผู้ใช้และสิทธิ์
                        </a>
                    </div>
                }
                @if (User.IsInRole("Admin"))
                {
                    <div class="col-sm-6 col-lg-4">
                        <a asp-controller="Management" asp-action="Settings" class="btn btn-outline-dark rounded-3 w-100 py-3">
                            <i class="fa-solid fa-building-columns me-2"></i>บัญชีรับโอน
                        </a>
                    </div>
                }
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script>
        const chartFont = { family: 'Kanit, sans-serif' };
        const currency = new Intl.NumberFormat('th-TH', {
            style: 'currency',
            currency: 'THB',
            maximumFractionDigits: 0
        });

        new Chart(document.getElementById('monthlySalesChart'), {
            type: 'line',
            data: {
                labels: @Html.Raw(JsonSerializer.Serialize(Model.SalesMonthLabels)),
                datasets: [{
                    label: 'ยอดค่าเช่าที่รับชำระแล้ว',
                    data: @Html.Raw(JsonSerializer.Serialize(Model.MonthlySales)),
                    borderColor: '#0d6efd',
                    backgroundColor: 'rgba(13, 110, 253, .14)',
                    fill: true,
                    tension: .35,
                    pointRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { labels: { font: chartFont } },
                    tooltip: { callbacks: { label: context => currency.format(context.parsed.y) } }
                },
                scales: {
                    x: { ticks: { font: chartFont } },
                    y: { beginAtZero: true, ticks: { font: chartFont, callback: value => currency.format(value) } }
                }
            }
        });

        new Chart(document.getElementById('topCarsChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(JsonSerializer.Serialize(Model.TopCarLabels)),
                datasets: [{
                    label: 'ยอดค่าเช่าที่รับชำระแล้ว',
                    data: @Html.Raw(JsonSerializer.Serialize(Model.TopCarSales)),
                    backgroundColor: ['#0d6efd', '#10b9dc', '#20c997', '#ffc107', '#6f42c1'],
                    borderRadius: 8
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: { callbacks: { label: context => currency.format(context.parsed.x) } }
                },
                scales: {
                    x: { beginAtZero: true, ticks: { font: chartFont, callback: value => currency.format(value) } },
                    y: { ticks: { font: chartFont } }
                }
            }
        });

        new Chart(document.getElementById('bookingStatusChart'), {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(JsonSerializer.Serialize(Model.BookingStatusLabels)),
                datasets: [{
                    data: @Html.Raw(JsonSerializer.Serialize(Model.BookingStatusCounts)),
                    backgroundColor: ['#6c757d', '#ffc107', '#0dcaf0', '#dc3545', '#198754', '#0d6efd', '#6f42c1', '#adb5bd'],
                    borderWidth: 2,
                    borderColor: '#fff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom', labels: { font: chartFont, padding: 14 } } }
            }
        });
    </script>
}
