@model IEnumerable<warat_0583_l005.Models.MaintenanceModel>
@using warat_0583_l005.Models
@{
    ViewData["Title"] = "ตรวจสภาพและซ่อมบำรุง";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var cars = (List<CarModel>)ViewBag.Cars;
    var inspections = (List<CarInspectionModel>)ViewBag.Inspections;
    var releaseBookings = (List<BookingModel>)ViewBag.ReleaseInspectionBookings;
    var inspectableReleaseBookingIds = (HashSet<int>)ViewBag.InspectableReleaseBookingIds;
    var returnReviewBookings = (List<BookingModel>)ViewBag.ReturnReviewBookings;
    var returnReceivedInspections = (Dictionary<int, CarInspectionModel>)ViewBag.ReturnReceivedInspections;
}

<div class="container py-4 py-lg-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="h2 fw-bold mb-1"><i class="fa-solid fa-screwdriver-wrench text-warning me-2"></i>ทีมเซอร์วิส — ตรวจสภาพและซ่อมบำรุง</h1>
            <p class="text-muted mb-0">ตรวจสภาพรถก่อนปล่อยเช่า ตรวจรถหลังรับคืน และบันทึกประวัติการซ่อมบำรุง</p>
        </div>
    </div>
    @if (TempData["ServiceMessage"] is string serviceMessage)
    {
        <div class="alert alert-info">@serviceMessage</div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header fw-bold"><i class="fa-solid fa-clipboard-check text-primary me-2"></i>ตรวจรถก่อนปล่อยเช่า</div>
        <div class="card-body">
            <p class="text-muted small">ตรวจเลขไมล์ น้ำมัน และสภาพรถก่อนส่งมอบ พนักงานจะส่งมอบรถได้เมื่อผลตรวจล่าสุดผ่านและรถไม่มีงานซ่อมค้าง</p>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>รายการจอง / ลูกค้า</th><th>รถ / กำหนดรับ</th><th>ผลตรวจ</th></tr></thead>
                    <tbody>
                    @foreach (var booking in releaseBookings)
                    {
                        var car = cars.FirstOrDefault(item => item.CarId == booking.CarId);
                        <tr>
                            <td>
                                <strong>#BK-@booking.BookingId</strong>
                                <span class="d-block text-muted small">@booking.UserId</span>
                            </td>
                            <td>
                                <strong>@booking.CarModel</strong>
                                <span class="d-block text-muted small">รับ @booking.PickupDate @booking.PickupTime</span>
                                <span class="badge @(car?.Status == "ว่าง" ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning-emphasis")">
                                    @(car?.Status ?? "ไม่พบรถ")
                                </span>
                            </td>
                            <td style="min-width: 360px;">
                                @if (inspectableReleaseBookingIds.Contains(booking.BookingId))
                                {
                                <form asp-action="InspectBeforeRelease" method="post" class="row g-2">
                                    <input type="hidden" name="bookingId" value="@booking.BookingId" />
                                    <div class="col-6">
                                        <label class="form-label small mb-1">เลขไมล์</label>
                                        <input name="mileage" type="number" min="0" class="form-control form-control-sm" required />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small mb-1">น้ำมัน (%)</label>
                                        <input name="fuelLevel" type="number" min="0" max="100" class="form-control form-control-sm" required />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label small mb-1">ค่าซ่อมโดยประมาณ (กรณีไม่ผ่าน)</label>
                                        <input name="damageAmount" type="number" min="0" step="0.01" value="0" class="form-control form-control-sm" />
                                    </div>
                                    <div class="col-12 d-flex gap-3">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="readyForRental" value="true" id="ready-@booking.BookingId" required />
                                            <label class="form-check-label small" for="ready-@booking.BookingId">ผ่าน / พร้อมปล่อย</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="readyForRental" value="false" id="failed-@booking.BookingId" />
                                            <label class="form-check-label small" for="failed-@booking.BookingId">ไม่ผ่าน / แจ้งซ่อม</label>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label small mb-1">หมายเหตุ / ตำหนิ (ต้องกรอกเมื่อไม่ผ่าน)</label>
                                        <input name="conditionNotes" maxlength="2000" class="form-control form-control-sm" />
                                    </div>
                                    <div class="col-12 text-end">
                                        <button class="btn btn-sm btn-primary" type="submit">
                                            <i class="fa-solid fa-floppy-disk me-1"></i>บันทึกผลตรวจ
                                        </button>
                                    </div>
                                </form>
                                }
                                else
                                {
                                    <div class="small text-warning-emphasis">
                                        <i class="fa-solid fa-triangle-exclamation me-1"></i>
                                        ต้องซ่อมให้เสร็จและเปลี่ยนสถานะรถเป็น “ว่าง” ก่อนตรวจปล่อย
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                    @if (releaseBookings.Count == 0)
                    {
                        <tr><td colspan="3" class="text-center text-muted py-4">ไม่มีรายการรอตรวจรถก่อนปล่อยเช่า</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header fw-bold"><i class="fa-solid fa-car-burst text-warning me-2"></i>ตรวจรถหลังลูกค้าคืน</div>
        <div class="card-body">
            <p class="text-muted small">ตรวจรถจริงและบันทึกเลขไมล์ น้ำมัน และความเสียหาย เมื่อตรวจเสร็จรายการจะส่งต่อฝ่ายการเงินเพื่อคืนมัดจำ</p>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>รายการจอง / ลูกค้า</th><th>การแจ้งคืนรถ</th><th>ข้อมูลรับรถจากพนักงาน</th><th>ผลตรวจทีมช่าง</th></tr></thead>
                    <tbody>
                    @foreach (var booking in returnReviewBookings)
                    {
                        <tr>
                            <td>
                                <strong>#BK-@booking.BookingId — @booking.CarModel</strong>
                                <span class="d-block text-muted small">@booking.UserId</span>
                            </td>
                            <td>
                                <span class="d-block small">ลูกค้าแจ้งส่งคืนรถ</span>
                                <span class="d-block small text-muted">@booking.ReturnSubmittedAt?.ToString("g")</span>
                            </td>
                            <td>
                                @if (returnReceivedInspections.TryGetValue(booking.BookingId, out var receivedInspection))
                                {
                                    <span class="d-block small">เลขไมล์ @receivedInspection.Mileage กม.</span>
                                    <span class="d-block small">น้ำมัน @receivedInspection.FuelLevel%</span>
                                    <span class="d-block small text-muted">@receivedInspection.ConditionNotes</span>
                                }
                            </td>
                            <td style="min-width: 340px;">
                                <form asp-action="InspectAfterReturn" method="post" class="row g-2">
                                    <input type="hidden" name="bookingId" value="@booking.BookingId" />
                                    <div class="col-6">
                                        <label class="form-label small mb-1">เลขไมล์ที่ช่างตรวจ</label>
                                        <input name="mileage" type="number" min="0" class="form-control form-control-sm" required />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small mb-1">น้ำมัน (%)</label>
                                        <input name="fuelLevel" type="number" min="0" max="100" class="form-control form-control-sm" required />
                                    </div>
                                    <div class="col-12 d-flex gap-3">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="damageFound" value="false" id="no-damage-@booking.BookingId" required />
                                            <label class="form-check-label small" for="no-damage-@booking.BookingId">ไม่พบความเสียหาย</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="damageFound" value="true" id="damage-@booking.BookingId" />
                                            <label class="form-check-label small" for="damage-@booking.BookingId">พบความเสียหาย</label>
                                        </div>
                                    </div>
                                    <div class="col-5">
                                        <label class="form-label small mb-1">ประเมินค่าซ่อม</label>
                                        <input name="damageAmount" type="number" min="0" step="0.01" value="0" class="form-control form-control-sm" required />
                                    </div>
                                    <div class="col-7">
                                        <label class="form-label small mb-1">รายละเอียดผลตรวจ</label>
                                        <input name="conditionNotes" maxlength="2000" class="form-control form-control-sm"
                                               placeholder="ระบุความเสียหาย หรือไม่พบความเสียหาย" required />
                                    </div>
                                    <div class="col-12 text-end">
                                        <button class="btn btn-sm btn-warning" type="submit">บันทึกผลตรวจหลังคืน</button>
                                    </div>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (returnReviewBookings.Count == 0)
                    {
                        <tr><td colspan="4" class="text-center text-muted py-4">ไม่มีรถรอตรวจหลังคืน</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header fw-bold">แจ้งซ่อม / แจ้งปัญหารถ</div>
        <div class="card-body">
            <form asp-action="ReportIssue" method="post" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">รถ</label>
                    <select name="carId" class="form-select" required>
                        @foreach (var car in cars) { <option value="@car.CarId">@car.CarName (#@car.CarId)</option> }
                    </select>
                </div>
                <div class="col-md-2"><label class="form-label">รหัสจอง (ถ้ามี)</label><input name="bookingId" type="number" min="1" class="form-control" /></div>
                <div class="col-md-4"><label class="form-label">รายละเอียดปัญหา</label><input name="issueDescription" maxlength="2000" class="form-control" required /></div>
                <div class="col-md-2"><label class="form-label">ประมาณค่าซ่อม</label><input name="repairCost" type="number" min="0" step="0.01" value="0" class="form-control" required /></div>
                <div class="col-md-1 d-flex align-items-end"><button class="btn btn-primary">บันทึก</button></div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header fw-bold">ประวัติการซ่อมบำรุง</div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>วันแจ้ง</th><th>รถ / รายการ</th><th>ค่าซ่อม</th><th>สถานะ</th><th>ปรับปรุง</th></tr></thead>
                <tbody>
                @foreach (var record in Model)
                {
                    <tr>
                        <td>@record.CreatedAt.ToString("g")</td>
                        <td>#@record.CarId / @record.IssueDescription</td>
                        <td>฿@record.RepairCost.ToString("N2")</td>
                        <td>@record.MaintenanceStatus</td>
                        <td>
                            <form asp-action="UpdateMaintenance" method="post" class="d-flex gap-2">
                                <input type="hidden" name="maintenanceId" value="@record.MaintenanceId" />
                                <input name="repairCost" type="number" min="0" step="0.01" value="@record.RepairCost" class="form-control form-control-sm" />
                                <select name="status" class="form-select form-select-sm">
                                    <option value="reported" selected="@(record.MaintenanceStatus == "reported")">แจ้งแล้ว</option>
                                    <option value="in_progress" selected="@(record.MaintenanceStatus == "in_progress")">กำลังซ่อม</option>
                                    <option value="completed" selected="@(record.MaintenanceStatus == "completed")">เสร็จแล้ว</option>
                                </select>
                                <button class="btn btn-sm btn-outline-primary">บันทึก</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="5" class="text-center text-muted py-3">ยังไม่มีประวัติซ่อม</td></tr> }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header fw-bold">ประวัติผลตรวจสภาพรถ</div>
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead><tr><th>Booking</th><th>ขั้นตอน</th><th>เลขไมล์</th><th>น้ำมัน</th><th>ความเสียหาย</th><th>พนักงาน</th><th>เวลา</th></tr></thead>
                <tbody>
                @foreach (var inspection in inspections)
                {
                    <tr><td>#@inspection.BookingId</td><td>@inspection.InspectionStage</td><td>@inspection.Mileage กม.</td><td>@inspection.FuelLevel%</td><td>฿@inspection.DamageAmount.ToString("N2")</td><td>@inspection.InspectedBy</td><td>@inspection.InspectedAt.ToString("g")</td></tr>
                }
                @if (inspections.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-3">ยังไม่มีผลตรวจ</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
</div>
