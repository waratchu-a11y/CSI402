<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DriverRent</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <style>
        :root {
            --driverent-blue: #0d6efd;
            --driverent-cyan: #10b9dc;
        }

        body {
            min-height: 100vh;
            margin: 0;
            display: flex;
            flex-direction: column;
            background: #f5f7fb;
            color: #172033;
            font-family: 'Kanit', sans-serif;
        }

        .admin-navbar {
            background: linear-gradient(105deg, #1268e8, #0879ed);
        }

        .admin-navbar .navbar-brand {
            white-space: nowrap;
        }

        .admin-navbar .nav-link {
            color: rgba(255,255,255,.92);
            border-radius: 999px;
            padding: .45rem .7rem;
            white-space: nowrap;
            font-size: .92rem;
        }

        .admin-navbar .nav-link:hover,
        .admin-navbar .nav-link.active {
            background: rgba(255,255,255,.16);
            color: #fff;
        }

        .admin-navbar .dropdown-menu {
            min-width: 13rem;
            border: 0;
            border-radius: 14px;
            box-shadow: 0 12px 30px rgba(15, 23, 42, .16);
            padding: .5rem;
        }

        .admin-navbar .dropdown-item {
            border-radius: 9px;
            padding: .55rem .7rem;
        }

        .admin-user {
            max-width: 150px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .admin-content {
            flex: 1;
        }

        .admin-footer {
            background: #1f2937;
        }

        .admin-content .card {
            border: 0;
            border-radius: 16px;
            box-shadow: 0 5px 20px rgba(31, 45, 61, .07);
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body data-admin-notification-user="@(User.Identity?.Name ?? "")">
    <nav class="navbar navbar-expand-xxl navbar-dark admin-navbar py-2 shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold fs-4 text-warning" asp-controller="Admin" asp-action="Index">
                <i class="fa-solid fa-car-side"></i> DriverRent
                <span class="badge rounded-pill bg-warning text-dark align-middle ms-1" style="font-size:.55rem;">BACK OFFICE</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNavbar"
                    aria-controls="adminNavbar" aria-expanded="false" aria-label="เปิดเมนู">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="adminNavbar">
                <ul class="navbar-nav me-auto my-2 my-xxl-0 gap-xxl-1">
                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Index"><i class="fa-solid fa-gauge-high me-1"></i>ภาพรวม</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Bookings">
                                <i class="fa-solid fa-calendar-check me-1"></i>รายการจอง
                                <span id="adminBookingNotificationBadge" class="badge rounded-pill bg-danger ms-1 d-none"
                                      aria-label="รายการจองที่รอดำเนินการ">0</span>
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fa-solid fa-sliders me-1"></i>จัดการระบบ
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="CarManagement"><i class="fa-solid fa-car me-2 text-primary"></i>จัดการรถ</a></li>
                                <li><a class="dropdown-item" asp-controller="Management" asp-action="Index"><i class="fa-solid fa-chart-line me-2 text-success"></i>รายงาน</a></li>
                                <li><a class="dropdown-item" asp-controller="Management" asp-action="Promotions"><i class="fa-solid fa-percent me-2 text-danger"></i>โปรโมชั่น</a></li>
                                <li><a class="dropdown-item" asp-controller="Management" asp-action="AddOnServices"><i class="fa-solid fa-puzzle-piece me-2 text-info"></i>บริการเสริม</a></li>
                            </ul>
                        </li>
                    }
                    @if (User.IsInRole("Admin") || User.IsInRole("Employee") || User.IsInRole("Service"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fa-solid fa-list-check me-1"></i>งานปฏิบัติการ
                            </a>
                            <ul class="dropdown-menu">
                                @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
                                {
                                    <li><a class="dropdown-item" asp-controller="Operations" asp-action="Index"><i class="fa-solid fa-clipboard-check me-2 text-primary"></i>งานรับ–คืนรถ</a></li>
                                }
                                @if (User.IsInRole("Admin") || User.IsInRole("Service"))
                                {
                                    <li><a class="dropdown-item" asp-controller="Service" asp-action="Index"><i class="fa-solid fa-screwdriver-wrench me-2 text-warning"></i>งานเซอร์วิส</a></li>
                                }
                            </ul>
                        </li>
                    }
                    @if (User.IsInRole("Admin") || User.IsInRole("Finance"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Payment" asp-action="ReviewQueue"><i class="fa-solid fa-money-check-dollar me-1"></i>การเงิน</a>
                        </li>
                    }
                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fa-solid fa-user-gear me-1"></i>ระบบ
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Management" asp-action="Users"><i class="fa-solid fa-users-gear me-2 text-secondary"></i>ผู้ใช้และสิทธิ์</a></li>
                                @if (User.IsInRole("Admin"))
                                {
                                    <li><a class="dropdown-item" asp-controller="Management" asp-action="Settings"><i class="fa-solid fa-building-columns me-2 text-primary"></i>บัญชีรับโอน</a></li>
                                }
                            </ul>
                        </li>
                    }
                </ul>
                <div class="d-flex align-items-center gap-2 flex-wrap py-2 py-xxl-0">
                    <a class="btn btn-sm btn-outline-light rounded-pill px-3" asp-controller="Home" asp-action="Indexcustomer">
                        <i class="fa-solid fa-house me-1"></i>หน้าเว็บไซต์
                    </a>
                    <span class="admin-user text-white small px-1" title="@User.Identity?.Name"><i class="fa-solid fa-user-shield me-1"></i>@User.Identity?.Name</span>
                    <a class="btn btn-sm btn-danger rounded-pill px-3" asp-controller="Account" asp-action="Logout">
                        <i class="fa-solid fa-right-from-bracket me-1"></i>ออกจากระบบ
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <main class="admin-content">
        @RenderBody()
    </main>

    <footer class="admin-footer text-white-50 py-3 mt-4">
        <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2 small">
            <span><i class="fa-solid fa-car-side text-warning me-1"></i> DriverRent ระบบจัดการหลังบ้าน</span>
            <span>&copy; 2026 DriverRent Car Rental System</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
    {
        @await Html.PartialAsync("_AdminBookingNotifications")
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
