@inject warat_0583_l005.Models.Csi402dbContext Db
@{
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    int customerNotificationCount = 0;
    if (User.IsInRole("Customer") && !string.IsNullOrWhiteSpace(User.Identity?.Name))
    {
        var customerBookings = Db.Bookings
            .Where(booking => booking.UserId == User.Identity!.Name &&
                (booking.BookingStatus == "pending_payment" ||
                 booking.BookingStatus == "payment_rejected" ||
                 booking.BookingStatus == "payment_review" ||
                 booking.BookingStatus == "confirmed"))
            .ToList();
        var customerBookingIds = customerBookings.Select(booking => booking.BookingId).ToList();
        var paymentsByBooking = Db.Payments
            .Where(payment => customerBookingIds.Contains(payment.BookingId))
            .ToList()
            .ToLookup(payment => payment.BookingId);

        foreach (var booking in customerBookings)
        {
            var payments = paymentsByBooking[booking.BookingId];
            if (booking.BookingStatus is "pending_payment" or "payment_rejected" or "payment_review")
            {
                customerNotificationCount++;
            }
            else if (booking.BookingStatus == "confirmed")
            {
                decimal rentalPaid = payments
                    .Where(payment => payment.PaymentType == "rental" && payment.PaymentStatus == "verified")
                    .Sum(payment => payment.Amount);
                bool rentalNeedsReview = payments.Any(payment =>
                    payment.PaymentType == "rental" &&
                    payment.PaymentStatus is "pending" or "rejected");
                if (rentalNeedsReview || rentalPaid < booking.TotalPrice)
                {
                    customerNotificationCount++;
                }
            }
        }
    }
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DriverRent</title>
    <!-- เรียกใช้ Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- เรียกใช้ Font Awesome สำหรับไอคอน -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <!-- เรียกใช้ฟอนต์ Kanit -->
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            font-family: 'Kanit', sans-serif;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            margin: 0;
        }
        main {
            flex: 1;
        }
        .footer-custom {
            margin-top: 2rem;
        }
    </style>
</head>
<body data-notification-url="@(User.IsInRole("Customer") ? Url.Action("CustomerNotifications", "Home") : "")"
      data-notification-user="@(User.Identity?.Name ?? "")"
      data-admin-notification-user="@(User.Identity?.Name ?? "")">
    <!-- ======================= HEADER ======================= -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom py-3 shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold fs-4 text-warning" href="~/Home/Indexcustomer">
                <i class="fa-solid fa-car-side"></i> DriverRent
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Home" && currentAction is "Index" or "Indexcustomer" ? "active" : "")"
                           href="~/Home/Indexcustomer"><i class="fa-solid fa-house"></i> หน้าแรก</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white @(currentController == "Home" && currentAction is "AllCars" or "SearchCars" ? "active" : "")"
                           href="~/Home/AllCars"><i class="fa-solid fa-car"></i> เลือกรถเช่า</a>
                    </li>
                    <!-- 📌 เมนูประวัติการจอง (วางอยู่ระหว่างเลือกรถเช่า) -->
                    <li class="nav-item">
                        <a class="nav-link text-white @(currentController == "Home" && currentAction == "MyBookings" ? "active" : "")"
                           href="~/Home/MyBookings">
                            <i class="fa-solid fa-clock-rotate-left"></i> ประวัติการจอง
                            @if (User.IsInRole("Customer"))
                            {
                                <span id="customerNotificationBadge"
                                      class="badge rounded-pill bg-danger ms-1 @(customerNotificationCount == 0 ? "d-none" : "")"
                                      aria-label="มี @customerNotificationCount รายการที่ต้องติดตาม">@customerNotificationCount</span>
                            }
                        </a>
                    </li>
                </ul>
                
                <!-- ปุ่มเมนูจัดการบัญชี (แสดงผลตามสถานะ Cookie) -->
                <div class="d-flex align-items-center gap-2">
                    @* เช็คว่ามี Cookie ชื่อ Username อยู่ไหม *@
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <!-- กรณีเข้าสู่ระบบแล้ว: โชว์โปรไฟล์ และ ออกจากระบบ -->
                        <a href="~/Home/Profile" class="btn btn-outline-light rounded-pill px-3">
                            <i class="fa-solid fa-user-circle me-1"></i> คุณ @User.Identity.Name
                        </a>
                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                        {
                            <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-light rounded-pill px-3">
                                ระบบหลังบ้าน
                                <span id="adminBookingNotificationBadge" class="badge rounded-pill bg-danger ms-1 d-none"
                                      aria-label="รายการจองที่รอดำเนินการ">0</span>
                            </a>
                        }
                        else if (User.IsInRole("Finance"))
                        {
                            <a asp-controller="Payment" asp-action="ReviewQueue" class="btn btn-outline-light rounded-pill px-3">ฝ่ายการเงิน</a>
                        }
                        else if (User.IsInRole("Employee"))
                        {
                            <a asp-controller="Operations" asp-action="Index" class="btn btn-outline-light rounded-pill px-3">งานรับ-คืนรถ</a>
                        }
                        else if (User.IsInRole("Service"))
                        {
                            <a asp-controller="Service" asp-action="Index" class="btn btn-outline-light rounded-pill px-3">งานเซอร์วิส</a>
                        }
                        <a href="~/Account/Logout" class="btn btn-danger rounded-pill px-3 shadow-sm">
                            <i class="fa-solid fa-right-from-bracket me-1"></i> ออกจากระบบ
                        </a>
                    }
                    else
                    {
                        <!-- กรณียังไม่ได้เข้าสู่ระบบ: โชว์ล็อกอิน และ สมัครสมาชิก -->
                        <a href="~/Account/Login" class="btn btn-outline-light rounded-pill px-3">
                            <i class="fa-solid fa-arrow-right-to-bracket me-1"></i> เข้าสู่ระบบ
                        </a>
                        <a href="~/Account/Register" class="btn btn-warning rounded-pill px-4 fw-bold text-dark shadow-sm">
                            <i class="fa-solid fa-user-plus me-1"></i> สมัครสมาชิก
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- ======================= MAIN CONTENT ======================= -->
    <main>
        @RenderBody()
    </main>

    <!-- ======================= FOOTER ======================= -->
    <footer class="footer-custom text-white py-5 w-100">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <h5 class="fw-bold text-warning"><i class="fa-solid fa-car-side"></i> DriverRent</h5>
                    <p class="small text-white-50 mt-3 pe-4">
                        บริการเช่ารถยนต์ออนไลน์ สะดวก ปลอดภัย ราคาคุ้มค่า ตอบโจทย์ทุกการเดินทางของคุณ ตลอด 24 ชั่วโมง
                    </p>
                </div>
                <div class="col-md-4">
                    <h6 class="fw-bold mb-3">เมนูแนะนำ</h6>
                    <ul class="list-unstyled small text-white-50 leading-loose">
                        <li class="mb-2"><a href="~/Home/AllCars" class="text-white-50 text-decoration-none">รถเช่าทั้งหมด</a></li>
                        <li class="mb-2"><a href="~/Home/MyBookings" class="text-white-50 text-decoration-none">ประวัติการจอง</a></li>
                        <li class="mb-2"><a href="~/Home/Profile" class="text-white-50 text-decoration-none">โปรไฟล์ของฉัน</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="fw-bold mb-3">ติดต่อเรา</h6>
                    <ul class="list-unstyled small text-white-50">
                        <li class="mb-2"><i class="fa-solid fa-phone text-warning me-2"></i> 02-123-4567</li>
                        <li class="mb-2"><i class="fa-solid fa-envelope text-warning me-2"></i> support@driverent.com</li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary mt-4 mb-3">
            <div class="text-center small text-white-50">
                &copy; 2026 DriverRent Car Rental System. All Rights Reserved.
            </div>
        </div>
    </footer>

    @if (User.IsInRole("Customer"))
    {
        <div id="customerNotificationToasts"
             class="toast-container position-fixed bottom-0 end-0 p-3"
             aria-live="polite"
             aria-atomic="true"
             style="z-index: 1090;"></div>
    }

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
    {
        @await Html.PartialAsync("_AdminBookingNotifications")
    }
    @if (User.IsInRole("Customer"))
    {
        <script>
            (() => {
                const notificationUrl = document.body.dataset.notificationUrl;
                const snapshotKey = `driverRentNotifications:${document.body.dataset.notificationUser}`;
                const badge = document.getElementById('customerNotificationBadge');
                const toastContainer = document.getElementById('customerNotificationToasts');
                let previousSnapshot = {};
                let hasPreviousSnapshot = false;
                let isChecking = false;

                try {
                    const storedSnapshot = sessionStorage.getItem(snapshotKey);
                    if (storedSnapshot !== null) {
                        previousSnapshot = JSON.parse(storedSnapshot);
                        hasPreviousSnapshot = true;
                    }
                } catch (error) {
                    console.warn('Could not restore the notification snapshot.', error);
                }

                function showNotification(notification) {
                    const toastElement = document.createElement('div');
                    toastElement.className = 'toast text-bg-primary border-0 shadow';
                    toastElement.setAttribute('role', 'alert');
                    toastElement.setAttribute('aria-live', 'assertive');
                    toastElement.setAttribute('aria-atomic', 'true');

                    const header = document.createElement('div');
                    header.className = 'toast-header';
                    const title = document.createElement('strong');
                    title.className = 'me-auto';
                    title.textContent = 'DriverRent แจ้งเตือน';
                    const closeButton = document.createElement('button');
                    closeButton.type = 'button';
                    closeButton.className = 'btn-close';
                    closeButton.setAttribute('data-bs-dismiss', 'toast');
                    closeButton.setAttribute('aria-label', 'ปิด');
                    header.append(title, closeButton);

                    const body = document.createElement('div');
                    body.className = 'toast-body';
                    const message = document.createElement('div');
                    message.textContent = notification.message;
                    const link = document.createElement('a');
                    link.href = notification.url;
                    link.className = 'btn btn-sm btn-light mt-2';
                    link.textContent = 'ดูรายการจอง';
                    body.append(message, link);

                    toastElement.append(header, body);
                    toastContainer.append(toastElement);
                    toastElement.addEventListener('hidden.bs.toast', () => toastElement.remove(), { once: true });
                    new bootstrap.Toast(toastElement, { delay: 12000 }).show();
                }

                async function checkNotifications() {
                    if (isChecking) return;
                    isChecking = true;
                    try {
                        const response = await fetch(notificationUrl, {
                            cache: 'no-store',
                            credentials: 'same-origin'
                        });
                        if (!response.ok) {
                            throw new Error(`Notification check failed with HTTP ${response.status}.`);
                        }

                        const state = await response.json();
                        const currentSnapshot = {};
                        for (const notification of state.notifications) {
                            const signature = JSON.stringify({
                                message: notification.message,
                                amount: notification.amount
                            });
                            currentSnapshot[notification.id] = signature;
                            if (hasPreviousSnapshot &&
                                (!Object.prototype.hasOwnProperty.call(previousSnapshot, notification.id) ||
                                 previousSnapshot[notification.id] !== signature)) {
                                showNotification(notification);
                            }
                        }
                        previousSnapshot = currentSnapshot;
                        sessionStorage.setItem(snapshotKey, JSON.stringify(currentSnapshot));
                        hasPreviousSnapshot = true;

                        if (badge) {
                            badge.textContent = state.count;
                            badge.classList.toggle('d-none', state.count === 0);
                            badge.setAttribute('aria-label', `มี ${state.count} รายการที่ต้องติดตาม`);
                        }
                    } catch (error) {
                        console.error('Unable to check customer notifications.', error);
                    } finally {
                        isChecking = false;
                    }
                }

                checkNotifications();
                window.setInterval(checkNotifications, 15000);
            })();
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>