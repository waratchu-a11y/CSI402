@model warat_0583_l005.Models.UserModel
@{
    ViewData["Title"] = "โปรไฟล์ของฉัน - DriverRent";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0" style="border-radius: 20px; overflow: hidden;">
                <!-- หัวการ์ดโปรไฟล์ -->
                <div class="text-white text-center py-4 px-3" style="background: var(--dr-gradient-brand);">
                    <div class="mb-3">
                        <div class="bg-white text-primary rounded-circle d-inline-flex justify-content-center align-items-center shadow" style="width: 80px; height: 80px; font-size: 2.5rem;">
                            <i class="fa-solid fa-user"></i>
                        </div>
                    </div>
                    <h3 class="mb-0 fw-bold">@(Model?.Username ?? "สมาชิกผู้ใช้งาน")</h3>
                    <p class="mb-0 mt-1 text-white-50 small">@(Model?.Email ?? "customer@email.com")</p>
                </div>

                <!-- รายละเอียดข้อมูลส่วนตัว -->
                <div class="card-body p-4 p-md-5 bg-white">
                    <h5 class="fw-bold mb-4 text-secondary"><i class="fa-solid fa-id-card text-primary me-2"></i> ข้อมูลบัญชีผู้ใช้</h5>
                    
                    <ul class="list-group list-group-flush mb-4">
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="text-muted"><i class="fa-solid fa-user me-2 text-primary"></i> ชื่อผู้ใช้ (Username)</span>
                            <span class="fw-bold text-dark">@(Model?.Username ?? "-")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="text-muted"><i class="fa-solid fa-envelope me-2 text-primary"></i> อีเมล (Email)</span>
                            <span class="fw-bold text-dark">@(Model?.Email ?? "-")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="text-muted"><i class="fa-solid fa-phone me-2 text-primary"></i> เบอร์โทรศัพท์</span>
                            <span class="fw-bold text-dark">@(Model?.Phone ?? "ไม่ระบุ")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="text-muted"><i class="fa-solid fa-venus-mars me-2 text-primary"></i> เพศ</span>
                            <span class="fw-bold text-dark">@(Model?.Gender ?? "ไม่ระบุ")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="text-muted"><i class="fa-solid fa-calendar-days me-2 text-primary"></i> สมาชิกตั้งแต่</span>
                            <span class="fw-bold text-dark">@(Model?.RegisterDate.ToString("dd/MM/yyyy") ?? "-")</span>
                        </li>
                    </ul>

                    <!-- ปุ่มควบคุม -->
                    <div class="d-grid gap-2">
                        <a href="~/Home/Indexcustomer" class="btn btn-primary btn-lg fw-bold shadow-sm py-2" style="border-radius: 12px;">
                            <i class="fa-solid fa-house me-1"></i> กลับสู่หน้าแรก
                        </a>
                        <a href="~/Account/Logout" class="btn btn-outline-danger fw-bold py-2" style="border-radius: 12px;">
                            <i class="fa-solid fa-right-from-bracket me-1"></i> ออกจากระบบ
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>