@model IEnumerable<warat_0583_l005.Models.CarModel>
@using warat_0583_l005.Models
@using System.Globalization
@{
    ViewData["Title"] = "หน้าแรก - DriverRent";
    // เรียกใช้ Layout สำหรับฝั่งลูกค้า
    Layout = "~/Views/Shared/_CustomerLayout.cshtml"; 
    var promotions = ViewBag.ActivePromotions as List<PromotionModel> ?? new List<PromotionModel>();
    var thaiCulture = CultureInfo.GetCultureInfo("th-TH");
    var unavailableCarIds = ViewBag.UnavailableCarIds as HashSet<int> ?? new HashSet<int>();
    var carLocations = ViewBag.CarLocations as string[] ?? Array.Empty<string>();
}

<!-- ส่วน Hero Banner และ ฟอร์มค้นหา -->
<div class="hero-section text-white py-5 mb-5 shadow" style="margin-top: -1px;">
    <div class="hero-grid-overlay" aria-hidden="true"></div>
    <div class="hero-light-beam" aria-hidden="true"></div>
    <!-- วงกลมตกแต่งพื้นหลังเพิ่มมิติ -->
    <div class="position-absolute hero-orb" style="top: -70px; right: -60px; width: 320px; height: 320px; background: rgba(255,255,255,0.08); border-radius: 50%; pointer-events: none;"></div>
    <div class="position-absolute hero-orb hero-orb-delay" style="bottom: -100px; left: -60px; width: 360px; height: 360px; background: rgba(255,255,255,0.04); border-radius: 50%; pointer-events: none;"></div>

    <div class="container text-center mt-4 position-relative z-1">
        <span class="badge badge-motion bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-3 shadow-sm">
            <i class="fa-solid fa-car-side me-1"></i> บริการเช่ารถอันดับ 1 ของคุณ
        </span>
        <h1 class="display-3 fw-bold mb-2">ค้นหารถเช่าที่เหมาะกับคุณ</h1>
        <p class="fs-5 text-white-50">จองง่าย จ่ายสะดวก พร้อมออกเดินทางได้ทันที ตลอด 24 ชั่วโมง</p>

        <!-- ฟอร์มค้นหารถ (Interactive Card) -->
        <div class="card p-4 shadow-lg mt-4 mx-auto text-dark search-card" style="max-width: 950px; border-radius: 20px; border: none; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px);">
            <!-- 📌 เพิ่ม Form tag ครอบตรงนี้ -->
            <form asp-controller="Home" asp-action="SearchCars" method="get">
                <div class="row g-3 align-items-end">
                    <div class="col-md-4 text-start">
                        <label class="form-label fw-bold text-secondary small"><i class="fa-solid fa-location-dot text-primary me-1"></i> สถานที่รับรถ</label>
                        <!-- 📌 เพิ่ม name="pickupLocation" -->
                        <select name="pickupLocation" class="form-select form-select-lg border-2 shadow-none" style="border-radius: 12px; font-size: 1rem;">
                            @foreach (var location in carLocations)
                            {
                                <option value="@location">@location</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 text-start">
                        <label class="form-label fw-bold text-secondary small"><i class="fa-regular fa-calendar-days text-primary me-1"></i> วันที่รับรถ</label>
                        <!-- 📌 เพิ่ม name="pickupDate" -->
                        <input id="searchPickupDate" type="date" name="pickupDate" min="@DateTime.Today.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" value="@DateTime.Today.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" class="form-control form-control-lg border-2 shadow-none" style="border-radius: 12px; font-size: 1rem;" required />
                    </div>
                    <div class="col-md-3 text-start">
                        <label class="form-label fw-bold text-secondary small"><i class="fa-regular fa-calendar-check text-primary me-1"></i> วันที่คืนรถ</label>
                        <!-- 📌 เพิ่ม name="returnDate" -->
                        <input id="searchReturnDate" type="date" name="returnDate" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" class="form-control form-control-lg border-2 shadow-none" style="border-radius: 12px; font-size: 1rem;" required />
                    </div>
                    <div class="col-md-2">
                        <!-- 📌 เพิ่ม type="submit" ให้ปุ่มทำงานได้ -->
                        <button type="submit" class="btn btn-warning btn-lg w-100 fw-bold text-dark shadow-sm search-btn" style="border-radius: 12px; height: 48px;">
                            <i class="fa-solid fa-magnifying-glass me-1"></i> ค้นหา
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <div class="d-flex justify-content-center flex-wrap gap-2 mt-4">
            <span class="trust-pill"><i class="fa-solid fa-shield-halved text-warning"></i> ประกันภัยชั้น 1 ทุกคัน</span>
            <span class="trust-pill"><i class="fa-solid fa-screwdriver-wrench text-warning"></i> ตรวจสภาพก่อนส่งมอบ</span>
            <span class="trust-pill"><i class="fa-solid fa-qrcode text-warning"></i> จ่ายมัดจำ 10% ผ่าน PromptPay</span>
            <span class="trust-pill"><i class="fa-solid fa-headset text-warning"></i> ดูแลตลอด 24 ชม.</span>
        </div>
    </div>
</div>

@if (promotions.Count > 0)
{
    <section class="container promo-announcements mb-5" aria-labelledby="promo-heading">
        <div class="promo-section-heading d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
            <div>
                <span class="promo-kicker"><i class="fa-solid fa-sparkles me-1"></i>ข้อเสนอพิเศษสำหรับคุณ</span>
                <h2 id="promo-heading" class="fw-bold mb-1 mt-2">โปรโมชันน่าใช้ <span class="promo-heading-accent">ออกเดินทางคุ้มกว่า</span></h2>
                <p class="text-muted mb-0">เลือกข้อเสนอที่ใช่ แล้วนำไปใช้ได้ในขั้นตอนจองรถ</p>
            </div>
            <a asp-controller="Home" asp-action="AllCars" class="btn btn-outline-primary rounded-pill px-4">
                เลือกรถเพื่อใช้โปรโมชัน <i class="fa-solid fa-arrow-right ms-1"></i>
            </a>
        </div>

        <div id="promoCarousel" class="carousel slide promo-carousel" aria-label="รายการโปรโมชัน">
            <div class="carousel-inner">
            @for (var index = 0; index < promotions.Count; index++)
            {
                var promotion = promotions[index];
                var themeClass = $"promo-theme-{index % 4}";
                var conditionLabel = promotion.ConditionType switch
                {
                    "new_user" => "สำหรับสมาชิกใหม่",
                    "3_days" => "เมื่อเช่าครบ 3 วัน",
                    "7_days" => "เมื่อเช่าครบ 7 วัน",
                    "weekday" => "จองและเช่าวันจันทร์–พฤหัสบดี",
                    "festival" => "โปรโมชันช่วงเทศกาล",
                    _ => "ส่วนลดพิเศษตามเงื่อนไข"
                };
                var startsLater = promotion.StartDate.HasValue && promotion.StartDate.Value.Date > DateTime.Today;

                <div class="carousel-item @(index == 0 ? "active" : "")" role="group" aria-label="โปรโมชัน @(index + 1) จาก @promotions.Count">
                    <article class="promo-card @themeClass h-100">
                        <div class="promo-card-glow"></div>
                        <div class="promo-card-content">
                            <div class="promo-card-main">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <span class="promo-status badge-motion @(startsLater ? "promo-status-upcoming" : "")">
                                        <i class="fa-solid @(startsLater ? "fa-clock" : "fa-bolt") me-1"></i>
                                        @(startsLater ? "เร็ว ๆ นี้" : "ข้อเสนอพิเศษ")
                                    </span>
                                    <i class="fa-solid fa-ticket promo-ticket-icon" aria-hidden="true"></i>
                                </div>
                                <div class="promo-discount mt-3">
                                    <span class="promo-discount-number">@promotion.DiscountPercent.ToString("0.#")</span>
                                    <span class="promo-discount-symbol">%</span>
                                    <span class="promo-discount-label">OFF</span>
                                </div>
                            </div>
                            <div class="promo-details">
                                <h3 class="promo-title">@promotion.PromotionName</h3>
                                <p class="promo-condition mb-3">@conditionLabel</p>

                                @if (promotion.StartDate.HasValue || promotion.EndDate.HasValue)
                                {
                                    <div class="promo-validity">
                                        <i class="fa-regular fa-calendar me-1"></i>
                                        @if (promotion.StartDate.HasValue && promotion.EndDate.HasValue)
                                        {
                                            <span>@promotion.StartDate.Value.ToString("dd MMM yyyy", thaiCulture) – @promotion.EndDate.Value.ToString("dd MMM yyyy", thaiCulture)</span>
                                        }
                                        else if (promotion.StartDate.HasValue)
                                        {
                                            <span>เริ่ม @promotion.StartDate.Value.ToString("dd MMM yyyy", thaiCulture)</span>
                                        }
                                        else
                                        {
                                            <span>ใช้ได้ถึง @promotion.EndDate!.Value.ToString("dd MMM yyyy", thaiCulture)</span>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="promo-card-footer">
                                @if (!string.IsNullOrWhiteSpace(promotion.PromotionCode))
                                {
                                    <button type="button" class="btn btn-sm btn-light bg-white bg-opacity-25 text-white border border-white border-opacity-50 fw-semibold" data-copy-code="@promotion.PromotionCode" title="คลิกเพื่อคัดลอกโค้ด">
                                        <i class="fa-solid fa-copy me-1"></i>@promotion.PromotionCode
                                    </button>
                                }
                                else
                                {
                                    <span class="promo-code promo-code-auto"><i class="fa-solid fa-check me-1"></i>ใช้ตามเงื่อนไข</span>
                                }
                                <a asp-controller="Home" asp-action="AllCars" class="promo-cta" aria-label="เลือกใช้โปรโมชัน @promotion.PromotionName">
                                    จองเลย <i class="fa-solid fa-arrow-up-right-from-square ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </article>
                </div>
            }
            </div>
        </div>
    </section>
}
else
{
    <section class="container promo-announcements mb-5" aria-labelledby="promo-heading">
        <div class="promo-empty">
            <div class="promo-empty-art" aria-hidden="true">
                <i class="fa-solid fa-ticket"></i>
                <span>%</span>
            </div>
            <div class="promo-empty-copy">
                <span class="promo-kicker"><i class="fa-solid fa-sparkles me-1"></i>DriverRent offers</span>
                <h2 id="promo-heading" class="fw-bold mt-2 mb-2">ขณะนี้ยังไม่มีโปรโมชันที่เปิดใช้งาน</h2>
                <p class="mb-0">กลับมาเยี่ยมชมอีกครั้ง หรือเลือกรถที่เหมาะกับการเดินทางของคุณได้เลย</p>
            </div>
            <a asp-controller="Home" asp-action="AllCars" class="btn btn-warning rounded-pill px-4 fw-semibold">
                เลือกรถเช่า <i class="fa-solid fa-arrow-right ms-1"></i>
            </a>
        </div>
    </section>
}

<!-- ส่วนแสดงรถเช่ายอดนิยม -->
<div class="container mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold m-0"><i class="fa-solid fa-fire text-danger me-2"></i>รถเช่ายอดนิยม</h3>
            <p class="text-muted small m-0 mt-1">คัดสรรรถยนต์คุณภาพดี พร้อมให้คุณโลดแล่นไปทุกเส้นทาง</p>
        </div>
        <a href="~/Home/AllCars" class="text-decoration-none fw-bold text-primary view-all-link">ดูรถทั้งหมด <i class="fa-solid fa-arrow-right ms-1"></i></a>
    </div>

    <div class="row g-4" data-reveal>
        @if (Model != null && Model.Any())
        {
            foreach (var car in Model)
            {
                var isAvailable = car.Status == "ว่าง" && !unavailableCarIds.Contains(car.CarId);
                var hasLocation = !string.IsNullOrWhiteSpace(car.Location);
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm car-card @(isAvailable ? "" : "opacity-75")" style="border-radius: 20px; border: none; overflow: hidden; transition: all 0.3s ease;">
                        <a asp-controller="Home" asp-action="CarDetail" asp-route-carName="@car.CarName" class="position-relative overflow-hidden d-block" style="height: 220px;">
                            <img src="@car.ImageUrl" class="card-img-top car-img" alt="@car.CarName" style="height: 100%; object-fit: cover; transition: transform 0.5s ease;" onerror="this.src='https://via.placeholder.com/400x220?text=No+Image';">
                            <span class="badge badge-motion @(isAvailable ? "bg-success" : "bg-danger") position-absolute top-0 end-0 m-3 px-3 py-2 shadow-sm rounded-pill z-1">
                                <i class="fa-solid @(isAvailable ? "fa-circle-check" : "fa-circle-xmark") me-1"></i>@(isAvailable ? "พร้อมใช้งาน" : "ไม่ว่าง")
                            </span>
                        </a>
                        <div class="card-body p-4">
                            <a asp-controller="Home" asp-action="CarDetail" asp-route-carName="@car.CarName" class="text-decoration-none text-dark">
                                <h5 class="card-title fw-bold mb-1 car-title-link">@car.CarName</h5>
                            </a>
                            <p class="text-muted small mb-3">@car.Details</p>
                            <p class="text-muted small mb-3">
                                <i class="fa-solid fa-location-dot text-primary me-1"></i>
                                ที่ตั้งรถ: @(string.IsNullOrWhiteSpace(car.Location) ? "ยังไม่ระบุ" : car.Location)
                            </p>
                            <hr class="text-muted opacity-25">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="text-muted small d-block">ราคาเริ่มต้น</span>
                                    <h4 class="text-primary fw-bold m-0">฿@car.PricePerDay.ToString("N0") <span class="fs-6 text-muted fw-normal">/วัน</span></h4>
                                </div>
                                @if (isAvailable && hasLocation)
                                {
                                    <a asp-controller="Account" asp-action="Lab52"
                                       asp-route-UserId="U001" asp-route-CarModel="@car.CarName"
                                       asp-route-PickupLocation="@car.Location"
                                       asp-route-PickupDate="@DateTime.Today.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)"
                                       asp-route-RentalDays="1" asp-route-PricePerDay="@car.PricePerDay"
                                       asp-route-TotalPrice="@car.PricePerDay"
                                       class="btn btn-warning fw-bold text-dark px-4 py-2 shadow-sm book-btn" style="border-radius: 12px;">
                                        จองรถ <i class="fa-solid fa-chevron-right ms-1 small"></i>
                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-secondary fw-bold px-4 py-2" style="border-radius: 12px;" disabled>
                                        @(hasLocation ? "ไม่ว่าง" : "ยังไม่ระบุที่ตั้ง")
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5 text-muted">
                <i class="fa-solid fa-car-rear fa-3x mb-3"></i>
                <h5>ยังไม่มีรถยนต์ให้บริการ</h5>
            </div>
        }
    </div>
</div>

<!-- ส่วนขั้นตอนการเช่ารถ 3 ขั้นตอน -->
<section class="container mb-5" data-reveal>
    <div class="text-center mb-4">
        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 mb-2 fw-semibold">
            <i class="fa-solid fa-route me-1"></i> ขั้นตอนง่ายๆ
        </span>
        <h2 class="fw-bold mb-1">เช่ารถกับ DriverRent ใน 3 ขั้นตอน</h2>
        <p class="text-muted mb-0">วางแผนการเดินทางได้ไว โปร่งใส ตรวจสอบสถานะได้ทุกขั้นตอน</p>
    </div>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="step-card p-4 h-100">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <span class="step-number">1</span>
                    <h5 class="fw-bold mb-0">เลือกรถและวันเดินทาง</h5>
                </div>
                <p class="text-muted small mb-0">ค้นหารถว่างตามจุดรับรถและวันที่ต้องการ พร้อมดูราคาและบริการเสริมได้ทันที</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="step-card p-4 h-100">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <span class="step-number">2</span>
                    <h5 class="fw-bold mb-0">โอนมัดจำ 10% &amp; แนบสลิป</h5>
                </div>
                <p class="text-muted small mb-0">สแกน QR PromptPay ที่ระบุยอดอัตโนมัติ และอัปโหลดสลิปให้ฝ่ายการเงินตรวจสอบ</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="step-card p-4 h-100">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <span class="step-number">3</span>
                    <h5 class="fw-bold mb-0">ตรวจสภาพ &amp; ออกเดินทาง</h5>
                </div>
                <p class="text-muted small mb-0">ทีมเซอร์วิสตรวจความพร้อมรถและพนักงานส่งมอบรถให้คุณออกเดินทางได้อย่างมั่นใจ</p>
            </div>
        </div>
    </div>
</section>

<script>
    window.addEventListener('DOMContentLoaded', () => {
        const pickup = document.getElementById('searchPickupDate');
        const returned = document.getElementById('searchReturnDate');

        function updateReturnDateRange() {
            if (!pickup.value) return;

            const pickupDate = new Date(`${pickup.value}T00:00:00Z`);
            const minReturn = new Date(pickupDate);
            minReturn.setUTCDate(minReturn.getUTCDate() + 1);
            const maxReturn = new Date(pickupDate);
            maxReturn.setUTCDate(maxReturn.getUTCDate() + 30);
            returned.min = minReturn.toISOString().slice(0, 10);
            returned.max = maxReturn.toISOString().slice(0, 10);

            if (returned.value < returned.min) returned.value = returned.min;
            if (returned.value > returned.max) returned.value = returned.max;
        }

        pickup.addEventListener('change', updateReturnDateRange);
        updateReturnDateRange();
    });
</script>
@section Scripts {
<script>
    (() => {
        const carouselElement = document.getElementById('promoCarousel');
        if (!carouselElement || carouselElement.querySelectorAll('.carousel-item').length < 2) return;

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        new bootstrap.Carousel(carouselElement, {
            interval: prefersReducedMotion ? false : 5000,
            pause: 'hover',
            ride: prefersReducedMotion ? false : 'carousel',
            touch: true,
            wrap: true
        });
    })();
</script>
}

<style>
    .promo-announcements {
        --promo-ink: #172033;
    }
    .promo-carousel {
        padding-bottom: .15rem;
    }
    .promo-empty {
        position: relative;
        display: flex;
        align-items: center;
        gap: 1.5rem;
        overflow: hidden;
        min-height: 150px;
        padding: 1.25rem clamp(1.1rem, 3vw, 2rem);
        border: 1px solid #e6edf7;
        border-radius: 22px;
        background: linear-gradient(110deg, #fff 0%, #f3f8ff 55%, #eefaff 100%);
        box-shadow: 0 10px 28px rgba(31, 45, 61, .06);
    }
    .promo-empty-art {
        position: relative;
        display: flex;
        flex: 0 0 76px;
        align-items: center;
        justify-content: center;
        width: 76px;
        height: 76px;
        border-radius: 20px;
        background: linear-gradient(145deg, #0d6efd, #10b9dc);
        color: #fff;
        font-size: 2rem;
        transform: rotate(-5deg);
    }
    .promo-empty-art span {
        position: absolute;
        top: -9px;
        right: -9px;
        display: grid;
        width: 28px;
        height: 28px;
        place-items: center;
        border: 3px solid #fff;
        border-radius: 50%;
        background: #ffc107;
        color: #172033;
        font-size: .85rem;
        font-weight: 700;
    }
    .promo-empty-copy {
        flex: 1;
    }
    .promo-empty-copy h2 {
        color: #172033;
        font-size: clamp(1.15rem, 2.2vw, 1.55rem);
    }
    .promo-empty-copy p {
        color: #667085;
    }
    .promo-kicker {
        color: #0d6efd;
        font-size: .82rem;
        font-weight: 600;
        letter-spacing: .04em;
        text-transform: uppercase;
    }
    .promo-heading-accent {
        color: #0d6efd;
    }
    .promo-card {
        position: relative;
        overflow: hidden;
        isolation: isolate;
        border-radius: 20px;
        color: #fff;
        box-shadow: 0 12px 30px rgba(23, 32, 51, .12);
        transition: transform .25s ease, box-shadow .25s ease;
    }
    .promo-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 18px 38px rgba(23, 32, 51, .18);
    }
    .promo-theme-0 { background: linear-gradient(135deg, #123f91 0%, #0879ed 58%, #22b8cf 100%); }
