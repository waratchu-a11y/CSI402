@{
    ViewData["Title"] = "ระบบหลังบ้าน";
    Layout = "_AdminLayout"; // เรียกใช้งาน Layout ฝั่ง Admin
}

<h2 class="fw-bold mb-4">📊 สรุปภาพรวมระบบ (Dashboard)</h2>

<!-- การ์ดแสดงสถานะแบบ Grid -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 bg-primary text-white p-3 shadow-sm">
            <h6><i class="bi bi-car-front-fill me-2"></i>รถยนต์ทั้งหมด</h6>
            <h2 class="fw-bold m-0">24 คัน</h2>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-success text-white p-3 shadow-sm">
            <h6><i class="bi bi-check-circle-fill me-2"></i>รายการจองวันนี้</h6>
            <h2 class="fw-bold m-0">8 รายการ</h2>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-warning text-dark p-3 shadow-sm">
            <h6><i class="bi bi-clock-history me-2"></i>รอการชำระเงิน</h6>
            <h2 class="fw-bold m-0">3 รายการ</h2>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-danger text-white p-3 shadow-sm">
            <h6><i class="bi bi-currency-dollar me-2"></i>รายได้เดือนนี้</h6>
            <h2 class="fw-bold m-0">฿145,000</h2>
        </div>
    </div>
</div>

<!-- ตารางรายการจองล่าสุด -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3">
        <h5 class="fw-bold m-0"><i class="bi bi-list-stars me-2"></i>รายการจองล่าสุด</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle m-0">
                <thead class="table-light">
                    <tr>
                        <th>รหัสการจอง</th>
                        <th>ชื่อลูกค้า</th>
                        <th>รุ่นรถ</th>
                        <th>วันที่เช่า</th>
                        <th>สถานะ</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>#BK-1001</td>
                        <td>คุณสมชาย ใจดี</td>
                        <td>Toyota Yaris Ativ</td>
                        <td>12 ก.ย. 2026</td>
                        <td><span class="badge bg-success">ชำระเงินแล้ว</span></td>
                    </tr>
                    <tr>
                        <td>#BK-1002</td>
                        <td>คุณวิภาดา สุขสันต์</td>
                        <td>Honda Civic RS</td>
                        <td>15 ก.ย. 2026</td>
                        <td><span class="badge bg-warning text-dark">รอยืนยัน</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>