@model warat_0583_l005.Models.CarModel
@{
    ViewData["Title"] = Model.CarName + " - DriverRent";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    var unavailableCarIds = ViewBag.UnavailableCarIds as HashSet<int> ?? new HashSet<int>();
    var isAvailable = Model.Status == "ว่าง" && !unavailableCarIds.Contains(Model.CarId);
    var hasLocation = !string.IsNullOrWhiteSpace(Model.Location);
}

<div class="container mt-5 mb-5">
    <!-- ปุ่มย้อนกลับ -->
    <div class="mb-4">
        <a href="~/Home/Indexcustomer" class="btn btn-outline-secondary rounded-pill px-4 fw-bold">
            <i class="fa-solid fa-arrow-left me-2"></i> กลับหน้าแรก
        </a>
    </div>

    <div class="row g-5">
        <!-- ฝั่งซ้าย: รูปภาพรถหลักและแกลเลอรี -->
        <div class="col-lg-7">
            <div class="card shadow-lg border-0" style="border-radius: 20px; overflow: hidden;">
                <div class="position-relative">
                    <!-- ดึงรูปภาพจาก Database -->
                    <img src="@Model.ImageUrl" class="card-img-top img-fluid" alt="@Model.CarName" style="height: 400px; object-fit: cover;" onerror="this.src='https://via.placeholder.com/600x400?text=No+Image';">
                    
                    @if (isAvailable && hasLocation)
                    {
                        <span class="badge bg-success position-absolute top-0 end-0 m-4 px-3 py-2 shadow-sm rounded-pill fs-6">
                            <i class="fa-solid fa-circle-check me-1"></i> พร้อมให้บริการ
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger position-absolute top-0 end-0 m-4 px-3 py-2 shadow-sm rounded-pill fs-6">
                            <i class="fa-solid fa-circle-xmark me-1"></i> ไม่ว่าง
                        </span>
                    }
                </div>
            </div>

            <!-- กล่องไฮไลต์ฟีเจอร์ -->
            <div class="row g-3 mt-4">
                <div class="col-4">
                    <div class="card p-3 text-center border-0 shadow-sm" style="border-radius: 15px;">
                        <i class="fa-solid fa-shield-halved text-primary fs-3 mb-2"></i>
                        <h6 class="fw-bold mb-0">ประกันภัยชั้น 1</h6>
                        <small class="text-muted">คุ้มครองครบครัน</small>
                    </div>
                </div>
                <div class="col-4">
                    <div class="card p-3 text-center border-0 shadow-sm" style="border-radius: 15px;">
                        <i class="fa-solid fa-road text-primary fs-3 mb-2"></i>
                        <h6 class="fw-bold mb-0">ไม่จำกัดระยะทาง</h6>
                        <small class="text-muted">ขับ Loei ทั่วไทย</small>
                    </div>
                </div>
                <div class="col-4">
                    <div class="card p-3 text-center border-0 shadow-sm" style="border-radius: 15px;">
                        <i class="fa-solid fa-headset text-primary fs-3 mb-2"></i>
                        <h6 class="fw-bold mb-0">Support 24 ชม.</h6>
                        <small class="text-muted">ช่วยเหลือฉุกเฉิน</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- ฝั่งขวา: รายละเอียดข้อมูลรถและปุ่มจอง -->
        <div class="col-lg-5">
            <div class="card shadow-lg border-0 p-4" style="border-radius: 20px;">
                <span class="text-uppercase text-primary fw-bold small">DriverRent Verified Car</span>
                
                <!-- ดึงชื่อรถจาก Database -->
                <h2 class="fw-bold text-dark mt-1 mb-3">@Model.CarName</h2>
                
                <h3 class="text-primary fw-bold mb-4">
                    <!-- ดึงราคาจาก Database -->
                    ฿@Model.PricePerDay.ToString("N0") <span class="fs-6 text-muted fw-normal">/ วัน</span>
                </h3>

                <hr class="text-muted opacity-25 mb-4">

                <h5 class="fw-bold mb-3"><i class="fa-solid fa-circle-info text-primary me-2"></i> ข้อมูลจำเพาะ</h5>
                
                <!-- ดึงรายละเอียดสเปกรถจาก Database -->
                <div class="alert alert-info border-0 rounded-3 mb-4">
                    <i class="fa-solid fa-car-side me-2"></i> <strong>รายละเอียด:</strong> @Model.Details
                </div>
                <div class="alert alert-light border rounded-3 mb-4">
                    <i class="fa-solid fa-location-dot text-primary me-2"></i>
                    <strong>ที่ตั้งรถ:</strong> @(string.IsNullOrWhiteSpace(Model.Location) ? "ยังไม่ระบุที่ตั้ง" : Model.Location)
                </div>

                <ul class="list-unstyled text-secondary mb-4">
                    <li class="mb-2"><i class="fa-solid fa-check text-success me-2"></i> ประเภทเกียร์: <strong>อัตโนมัติ (Auto)</strong></li>
                    <li class="mb-2"><i class="fa-solid fa-check text-success me-2"></i> ระบบแอร์ & ความบันเทิง: <strong>Apple CarPlay / Android Auto</strong></li>
                </ul>

                <div class="alert alert-light border rounded-3 small text-muted mb-4">
                    <i class="fa-solid fa-triangle-exclamation text-warning me-1"></i> เงื่อนไข: ผู้เช่าต้องมีอายุ 20 ปีขึ้นไป และใช้ใบขับขี่ในการรับรถ
                </div>

                <!-- ปุ่มกดดำเนินการจอง -->
                <div class="d-grid gap-2">
                    @if (isAvailable && hasLocation)
                    {
                        <a asp-controller="Account" asp-action="Lab52"
                           asp-route-CarModel="@Model.CarName"
                           asp-route-PickupLocation="@Model.Location"
                           asp-route-PricePerDay="@Model.PricePerDay"
                           class="btn btn-warning btn-lg fw-bold text-dark shadow-sm py-3" style="border-radius: 12px;">
                            <i class="fa-solid fa-calendar-check me-2"></i> ยืนยันจองรถคันนี้ทันที
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-secondary btn-lg fw-bold text-white shadow-sm py-3" style="border-radius: 12px;" disabled>
                            <i class="fa-solid fa-ban me-2"></i> @(hasLocation ? "รถไม่ว่าง" : "ยังไม่ระบุที่ตั้งรถ")
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>