@using warat_0583_l005.Models
@inject Csi402dbContext _db
@{
    ViewData["Title"] = "ประวัติการจองของฉัน - DriverRent";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";

    string currentUsername = User.Identity?.Name ?? "";
    
    var myBookings = _db.Set<BookingModel>()
                        .Where(b => b.UserId == currentUsername)
                        .OrderByDescending(b => b.BookingId)
                        .ToList();
    var bookingIds = myBookings.Select(booking => booking.BookingId).ToList();
    var paymentsByBooking = _db.Payments
        .Where(payment => bookingIds.Contains(payment.BookingId))
        .ToList()
        .ToLookup(payment => payment.BookingId);
    var latestReleaseInspections = _db.CarInspections
        .Where(inspection => bookingIds.Contains(inspection.BookingId) &&
            inspection.InspectionStage == "pre_release")
        .ToList()
        .GroupBy(inspection => inspection.BookingId)
        .ToDictionary(
            group => group.Key,
            group => group.OrderByDescending(inspection => inspection.InspectionId).First());
    var bookingsWithOpenMaintenance = _db.MaintenanceRecords
        .Where(record => record.BookingId.HasValue &&
            bookingIds.Contains(record.BookingId.Value) &&
            record.MaintenanceStatus != "completed")
        .Select(record => record.BookingId!.Value)
        .Distinct()
        .ToHashSet();
}

<div class="bg-primary text-white py-4 shadow-sm mb-5" style="background: linear-gradient(135deg, #0d6efd 0%, #0dcaf0 100%);">
    <div class="container">
        <h2 class="fw-bold mb-1"><i class="fa-solid fa-clock-rotate-left me-2"></i> ประวัติการจองของฉัน</h2>
        <p class="text-white-50 m-0">ตรวจสอบรายการจองรถและสถานะการเดินทางของคุณได้ที่นี่</p>
    </div>
</div>

<div class="container mb-5">
    @if (TempData["PaymentMessage"] is string paymentMessage)
    {
        <div class="alert alert-info">@paymentMessage</div>
    }
    <div class="card shadow-sm border-0" style="border-radius: 20px; overflow: hidden;">
        <div class="card-header bg-white py-3 px-4 border-bottom">
            <h5 class="fw-bold m-0 text-dark"><i class="fa-solid fa-list-check text-primary me-2"></i> รายการจองรถทั้งหมดของคุณ (@currentUsername)</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 booking-responsive-table">
                    <thead class="table-light text-secondary small text-uppercase">
                        <tr>
                            <th class="py-3 px-4">รุ่นรถยนต์</th>
                            <th class="py-3">สถานที่รับรถ</th>
                            <th class="py-3">วันที่รับรถ</th>
                            <th class="py-3">จำนวนวัน</th>
                            <th class="py-3">ราคารวม</th>
                            <th class="py-3 text-center">สถานะ</th>
                            <th class="py-3 text-center">จัดการ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (myBookings.Any())
                        {
                            @foreach (var item in myBookings)
                            {
                                var bookingPayments = paymentsByBooking[item.BookingId];
                                var rentalPaid = bookingPayments
                                    .Where(payment => payment.PaymentType == "rental" && payment.PaymentStatus == "verified")
                                    .Sum(payment => payment.Amount);
                                var rentalRemaining = Math.Max(0m, item.TotalPrice - rentalPaid);
                                var pendingRentalPayment = bookingPayments.Any(payment =>
                                    payment.PaymentType == "rental" && payment.PaymentStatus == "pending");
                                var latestRentalPayment = bookingPayments
                                    .Where(payment => payment.PaymentType == "rental")
                                    .OrderByDescending(payment => payment.PaymentId)
                                    .FirstOrDefault();
                                var rejectedRentalPayment = latestRentalPayment?.PaymentStatus == "rejected"
                                    ? latestRentalPayment
                                    : null;
                                var rejectedDepositPayment = bookingPayments
                                    .Where(payment => payment.PaymentType == "deposit" && payment.PaymentStatus == "rejected")
                                    .OrderByDescending(payment => payment.PaymentId)
                                    .FirstOrDefault();
                                var depositVerified = bookingPayments.Any(payment =>
                                    payment.PaymentType == "deposit" && payment.PaymentStatus == "verified");
                                var refundCompleted = bookingPayments.Any(payment =>
                                    payment.PaymentType == "refund" && payment.PaymentStatus == "completed");
                                var deductionCompleted = bookingPayments.Any(payment =>
                                    payment.PaymentType == "deduction" && payment.PaymentStatus == "verified");
                                var returnRepairOpen = bookingsWithOpenMaintenance.Contains(item.BookingId);
                                var hasReleaseInspection = latestReleaseInspections.TryGetValue(item.BookingId, out var releaseInspection);
                                var releasePassed = hasReleaseInspection && releaseInspection!.InspectionStatus == "passed";
                                var releaseFailed = hasReleaseInspection && releaseInspection!.InspectionStatus == "failed";
                                var rentalPaymentPending = pendingRentalPayment;
                                var rentalPaymentRejected = rejectedRentalPayment is not null;
                                var rentalPaidInFull = rentalRemaining <= 0m;
                                var readyForHandover = depositVerified &&
                                    item.LicenseStatus == "approved" &&
                                    releasePassed &&
                                    rentalPaidInFull;
                                var currentStageLabel = "กำลังดำเนินการ";
                                var currentStageClass = "bg-warning text-dark";
                                if (item.BookingStatus == "confirmed")
                                {
                                    if (item.LicenseStatus == "rejected")
                                    {
                                        currentStageLabel = "รอส่งใบขับขี่ใหม่";
                                        currentStageClass = "bg-danger";
                                    }
                                    else if (item.LicenseStatus != "approved")
                                    {
                                        currentStageLabel = "รอตรวจใบขับขี่";
                                    }
                                    else if (releaseFailed)
                                    {
                                        currentStageLabel = "ทีมช่างกำลังซ่อมรถ";
                                        currentStageClass = "bg-danger";
                                    }
                                    else if (!releasePassed)
                                    {
                                        currentStageLabel = "รอทีมช่างตรวจรถ";
                                    }
                                    else if (rentalPaymentPending)
                                    {
                                        currentStageLabel = "รอตรวจสอบค่าเช่า";
                                        currentStageClass = "bg-info text-dark";
                                    }
                                    else if (rentalPaymentRejected)
                                    {
                                        currentStageLabel = "รอส่งหลักฐานค่าเช่าใหม่";
                                        currentStageClass = "bg-danger";
                                    }
                                    else if (!rentalPaidInFull)
                                    {
                                        currentStageLabel = "รอชำระค่าเช่า";
                                    }
                                    else if (readyForHandover)
                                    {
                                        currentStageLabel = "รอพนักงานส่งมอบรถ";
                                        currentStageClass = "bg-info text-dark";
                                    }
                                }
                                <tr>
                                    <td class="py-3 px-4 fw-bold text-dark" data-label="รถยนต์ / รหัสจอง">
                                        <div class="d-flex align-items-center">
                                            <i class="fa-solid fa-car text-primary fs-4 me-3"></i>
                                            <div>
                                                @item.CarModel
                                                <span class="d-block text-muted small fw-normal">รหัสการจอง: #BK-@item.BookingId</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td data-label="สถานที่รับรถ">@item.PickupLocation</td>
                                    <td data-label="วันที่รับรถ">@item.PickupDate</td>
                                    <td data-label="จำนวนวัน">@item.RentalDays วัน</td>
                                    <td class="fw-bold text-primary" data-label="ราคารวม">฿@item.TotalPrice.ToString("N0")</td>
                                    <td class="text-center" data-label="สถานะ">
                                        @if (item.BookingStatus == "pending_payment")
                                        {
                                            <span class="badge badge-motion bg-warning text-dark px-3 py-2 rounded-pill">รอชำระมัดจำ</span>
                                        }
                                        else if (item.BookingStatus == "payment_rejected")
                                        {
                                            <span class="badge badge-motion bg-danger px-3 py-2 rounded-pill">มัดจำถูกปฏิเสธ</span>
                                            <span class="d-block small text-danger mt-1">@(rejectedDepositPayment?.Note ?? "กรุณาส่งหลักฐานมัดจำใหม่")</span>
                                        }
                                        else if (item.BookingStatus == "payment_review")
                                        {
                                            <span class="badge badge-motion bg-info text-dark px-3 py-2 rounded-pill">รอตรวจสอบสลิป</span>
                                            <div class="alert alert-info py-2 px-3 mt-2 mb-0 small text-start">
                                                <i class="fa-solid fa-hourglass-half me-1"></i>
                                                ได้รับหลักฐานมัดจำแล้ว กำลังตรวจสอบโดยฝ่ายการเงิน
                                            </div>
                                        }
                                        else if (item.BookingStatus == "confirmed")
                                        {
                                            <span class="badge badge-motion @currentStageClass px-3 py-2 rounded-pill">@currentStageLabel</span>
                                            @if (pendingRentalPayment)
                                            {
                                                <div class="alert alert-info py-2 px-3 mt-2 mb-0 small text-start">
                                                    <i class="fa-solid fa-hourglass-half me-1"></i>
                                                    กำลังตรวจสอบหลักฐานชำระค่าเช่าโดยฝ่ายการเงิน
                                                </div>
                                            }
                                            else if (rejectedRentalPayment is not null && rentalRemaining > 0)
                                            {
                                                <div class="alert alert-warning py-2 px-3 mt-2 mb-0 small text-start">
                                                    <i class="fa-solid fa-triangle-exclamation me-1"></i>
                                                    หลักฐานค่าเช่าถูกปฏิเสธ: @(rejectedRentalPayment.Note ?? "กรุณาตรวจสอบและส่งใหม่")
                                                </div>
                                            }
                                            else if (rentalRemaining > 0)
                                            {
                                                <div class="alert alert-success py-2 px-3 mt-2 mb-0 small text-start">
                                                    <i class="fa-solid fa-circle-check me-1"></i>
                                                    ฝ่ายการเงินยืนยันมัดจำแล้ว กรุณาชำระค่าเช่าคงเหลือ ฿@rentalRemaining.ToString("N2")
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="alert alert-success py-2 px-3 mt-2 mb-0 small text-start">
                                                    <i class="fa-solid fa-circle-check me-1"></i> ชำระค่าเช่าครบแล้ว
                                                </div>
                                            }
                                        }
                                        else if (item.BookingStatus == "rented")
                                        {
                                            <span class="badge badge-motion bg-primary px-3 py-2 rounded-pill">กำลังเช่า</span>
                                        }
                                        else if (item.BookingStatus == "return_requested")
                                        {
                                            <span class="badge badge-motion bg-warning text-dark px-3 py-2 rounded-pill">รอพนักงานตรวจรับคืน</span>
                                            <div class="alert alert-info py-2 px-3 mt-2 mb-0 small text-start">
                                                <i class="fa-solid fa-hourglass-half me-1"></i>
                                                ส่งข้อมูลแล้ว กรุณานำรถส่งมอบให้พนักงานตรวจรับ
                                            </div>
                                        }
                                        else if (item.BookingStatus == "service_review")
                                        {
                                            <span class="badge badge-motion bg-info text-dark px-3 py-2 rounded-pill">รอช่างตรวจสอบคืนรถ</span>
                                            <div class="alert alert-info py-2 px-3 mt-2 mb-0 small text-start">
                                                <i class="fa-solid fa-hourglass-half me-1"></i>
                                                รับแจ้งคืนรถแล้ว ทีมช่างจะตรวจสภาพก่อนส่งเรื่องให้ฝ่ายการเงินคืนเงินมัดจำ
                                            </div>
                                        }
                                        else if (item.BookingStatus == "completed")
                                        {
                                            <span class="badge badge-motion bg-secondary px-3 py-2 rounded-pill">คืนรถแล้ว</span>
                                            @if (refundCompleted)
                                            {
                                                <div class="alert alert-success py-2 px-3 mt-2 mb-0 small text-start">
                                                    <i class="fa-solid fa-circle-check me-1"></i>ฝ่ายการเงินคืนเงินมัดจำแล้ว
                                                </div>
                                            }
                                            else if (returnRepairOpen)
                                            {
                                                <div class="alert alert-warning py-2 px-3 mt-2 mb-0 small text-start">
                                                    <i class="fa-solid fa-screwdriver-wrench me-1"></i>
                                                    ทีมช่างกำลังจัดการความเสียหายก่อนสรุปเงินมัดจำ
                                                </div>
                                            }
                                            else if (depositVerified && !deductionCompleted)
                                            {
                                                <div class="alert alert-info py-2 px-3 mt-2 mb-0 small text-start">
                                                    <i class="fa-solid fa-hourglass-half me-1"></i>
                                                    ช่างตรวจรถแล้ว ส่งเรื่องให้ฝ่ายการเงินคืนเงินมัดจำ
                                                </div>
                                            }
                                            else if (deductionCompleted)
                                            {
                                                <div class="alert alert-info py-2 px-3 mt-2 mb-0 small text-start">
                                                    ฝ่ายการเงินสรุปการหักค่าซ่อมจากเงินมัดจำแล้ว
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge badge-motion bg-secondary px-3 py-2 rounded-pill">@item.BookingStatus</span>
                                        }
                                        @if (item.BookingStatus == "confirmed")
                                        {
                                            <span class="d-block small mt-1">ค่าเช่าคงเหลือ ฿@rentalRemaining.ToString("N2")</span>
                                            <span class="d-block small mt-1">ใบขับขี่:
                                                @(item.LicenseStatus == "approved" ? "ผ่านการตรวจแล้ว" : item.LicenseStatus == "rejected" ? "ไม่ผ่าน" : "รอตรวจสอบ")
                                            </span>
                                            @if (item.LicenseStatus == "rejected" && !string.IsNullOrWhiteSpace(item.LicenseReviewNote))
                                            {
                                                <span class="d-block small text-danger">@item.LicenseReviewNote</span>
                                            }
                                        }
                                    </td>
                                    <td class="text-center" data-label="จัดการ">
                                        @if (item.LicenseStatus == "rejected" && item.BookingStatus == "confirmed")
                                        {
                                            <form asp-controller="Payment" asp-action="SubmitLicense" method="post" enctype="multipart/form-data" class="mb-2">
                                                <input type="hidden" name="bookingId" value="@item.BookingId" />
                                                <input type="file" name="licenseImage" accept=".jpg,.jpeg,.png,image/jpeg,image/png" class="form-control form-control-sm mb-1" required />
                                                <button class="btn btn-warning btn-sm">ส่งใบขับขี่ใหม่</button>
                                            </form>
                                        }
                                        <a asp-controller="Account" asp-action="BookingReceipt"
                                           asp-route-id="@item.BookingId"
                                           class="btn btn-outline-primary btn-sm px-3 fw-bold" style="border-radius: 8px;">
                                            <i class="fa-solid fa-file-invoice me-1"></i> ดูใบเสร็จ
                                        </a>
                                        @if (item.BookingStatus is "pending_payment" or "payment_rejected")
                                        {
                                            <a asp-controller="Payment" asp-action="SubmitDeposit" asp-route-bookingId="@item.BookingId" class="btn btn-success btn-sm fw-bold ms-1">ส่งสลิปมัดจำ</a>
                                            <form asp-controller="Home" asp-action="CancelBooking" method="post" class="d-inline" onsubmit="return confirm('ยืนยันยกเลิกการจองนี้หรือไม่?');">
                                                <input type="hidden" name="id" value="@item.BookingId" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm fw-bold ms-1">ยกเลิก</button>
                                            </form>
                                        }
                                        @if (item.BookingStatus == "confirmed")
                                        {
                                            @if (rentalRemaining > 0 && !pendingRentalPayment)
                                            {
                                                <a asp-controller="Payment" asp-action="SubmitRentalPayment" asp-route-bookingId="@item.BookingId" class="btn btn-outline-success btn-sm fw-bold">ชำระค่าเช่า</a>
                                            }
                                        }
                                        @if (item.BookingStatus == "rented")
                                        {
                                            <form asp-controller="Home" asp-action="RequestReturn" method="post"
                                                  class="mt-2 text-start"
                                                  onsubmit="return confirm('ยืนยันส่งรถคืนเพื่อให้ทีมช่างตรวจสอบหรือไม่?');">
                                                <input type="hidden" name="id" value="@item.BookingId" />
                                                <button type="submit" class="btn btn-warning btn-sm fw-bold">
                                                    <i class="fa-solid fa-car-side me-1"></i>ส่งรถคืน
                                                </button>
                                            </form>
                                            <span class="d-block small text-muted mt-1">
                                                คืนที่ @item.ReturnLocation วันที่ @item.ReturnDate?.ToString("yyyy-MM-dd") @item.ReturnTime
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted" data-label="">
                                    <i class="fa-solid fa-folder-open fa-2x mb-2 d-block"></i> ยังไม่มีประวัติการจองรถในระบบ
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>