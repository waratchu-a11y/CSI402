@using warat_0583_l005.Models
@inject Csi402dbContext _db
@{
    ViewData["Title"] = "ประวัติการจองของฉัน - DriverRent";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";

    string currentUsername = User.Identity?.Name ?? "";
    
    var myBookings = _db.Set<BookingModel>()
                        .Where(b => b.UserId == currentUsername)
                        .OrderByDescending(b => b.BookingId)
                        .ToList();
}

<div class="bg-primary text-white py-4 shadow-sm mb-5" style="background: linear-gradient(135deg, #0d6efd 0%, #0dcaf0 100%);">
    <div class="container">
        <h2 class="fw-bold mb-1"><i class="fa-solid fa-clock-rotate-left me-2"></i> ประวัติการจองของฉัน</h2>
        <p class="text-white-50 m-0">ตรวจสอบรายการจองรถและสถานะการเดินทางของคุณได้ที่นี่</p>
    </div>
</div>

<div class="container mb-5">
    @if (TempData["PaymentMessage"] is string paymentMessage)
    {
        <div class="alert alert-info">@paymentMessage</div>
    }
    <div class="card shadow-sm border-0" style="border-radius: 20px; overflow: hidden;">
        <div class="card-header bg-white py-3 px-4 border-bottom">
            <h5 class="fw-bold m-0 text-dark"><i class="fa-solid fa-list-check text-primary me-2"></i> รายการจองรถทั้งหมดของคุณ (@currentUsername)</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small text-uppercase">
                        <tr>
                            <th class="py-3 px-4">รุ่นรถยนต์</th>
                            <th class="py-3">สถานที่รับรถ</th>
                            <th class="py-3">วันที่รับรถ</th>
                            <th class="py-3">จำนวนวัน</th>
                            <th class="py-3">ราคารวม</th>
                            <th class="py-3 text-center">สถานะ</th>
                            <th class="py-3 text-center">จัดการ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (myBookings.Any())
                        {
                            @foreach (var item in myBookings)
                            {
                                <tr>
                                    <td class="py-3 px-4 fw-bold text-dark">
                                        <div class="d-flex align-items-center">
                                            <i class="fa-solid fa-car text-primary fs-4 me-3"></i>
                                            <div>
                                                @item.CarModel
                                                <span class="d-block text-muted small fw-normal">รหัสการจอง: #BK-@item.BookingId</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@item.PickupLocation</td>
                                    <td>@item.PickupDate</td>
                                    <td>@item.RentalDays วัน</td>
                                    <td class="fw-bold text-primary">฿@item.TotalPrice.ToString("N0")</td>
                                    <td class="text-center">
                                        @if (item.BookingStatus is "pending_payment" or "payment_rejected")
                                        {
                                            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">รอชำระมัดจำ</span>
                                        }
                                        else if (item.BookingStatus == "payment_review")
                                        {
                                            <span class="badge bg-info text-dark px-3 py-2 rounded-pill">รอตรวจสอบสลิป</span>
                                        }
                                        else if (item.BookingStatus == "confirmed")
                                        {
                                            <span class="badge bg-success px-3 py-2 rounded-pill">ยืนยันแล้ว</span>
                                        }
                                        else if (item.BookingStatus == "rented")
                                        {
                                            <span class="badge bg-primary px-3 py-2 rounded-pill">กำลังเช่า</span>
                                        }
                                        else if (item.BookingStatus == "completed")
                                        {
                                            <span class="badge bg-secondary px-3 py-2 rounded-pill">คืนรถแล้ว</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary px-3 py-2 rounded-pill">@item.BookingStatus</span>
                                        }
                                        @if (item.BookingStatus == "confirmed")
                                        {
                                            var rentalPaid = _db.Payments.Where(payment => payment.BookingId == item.BookingId && payment.PaymentType == "rental" && payment.PaymentStatus == "verified").Sum(payment => (decimal?)payment.Amount) ?? 0m;
                                            <span class="d-block small mt-1">ค่าเช่าคงเหลือ ฿@Math.Max(0m, item.TotalPrice - rentalPaid).ToString("N2")</span>
                                            <span class="d-block small mt-1">ใบขับขี่: @item.LicenseStatus</span>
                                            @if (item.LicenseStatus == "rejected" && !string.IsNullOrWhiteSpace(item.LicenseReviewNote))
                                            {
                                                <span class="d-block small text-danger">@item.LicenseReviewNote</span>
                                            }
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (item.LicenseStatus == "rejected" && item.BookingStatus == "confirmed")
                                        {
                                            <form asp-controller="Payment" asp-action="SubmitLicense" method="post" enctype="multipart/form-data" class="mb-2">
                                                <input type="hidden" name="bookingId" value="@item.BookingId" />
                                                <input type="file" name="licenseImage" accept=".jpg,.jpeg,.png,image/jpeg,image/png" class="form-control form-control-sm mb-1" required />
                                                <button class="btn btn-warning btn-sm">ส่งใบขับขี่ใหม่</button>
                                            </form>
                                        }
                                        <a asp-controller="Account" asp-action="BookingReceipt"
                                           asp-route-id="@item.BookingId"
                                           class="btn btn-outline-primary btn-sm px-3 fw-bold" style="border-radius: 8px;">
                                            <i class="fa-solid fa-file-invoice me-1"></i> ดูใบเสร็จ
                                        </a>
                                        @if (item.BookingStatus is "pending_payment" or "payment_rejected")
                                        {
                                            <a asp-controller="Payment" asp-action="SubmitDeposit" asp-route-bookingId="@item.BookingId" class="btn btn-success btn-sm fw-bold ms-1">ส่งสลิปมัดจำ</a>
                                            <form asp-controller="Home" asp-action="CancelBooking" method="post" class="d-inline" onsubmit="return confirm('ยืนยันยกเลิกการจองนี้หรือไม่?');">
                                                <input type="hidden" name="id" value="@item.BookingId" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm fw-bold ms-1">ยกเลิก</button>
                                            </form>
                                        }
                                        @if (item.BookingStatus == "confirmed")
                                        {
                                            var rentalPaid = _db.Payments.Where(payment => payment.BookingId == item.BookingId && payment.PaymentType == "rental" && payment.PaymentStatus == "verified").Sum(payment => (decimal?)payment.Amount) ?? 0m;
                                            @if (rentalPaid < item.TotalPrice)
                                            {
                                                <a asp-controller="Payment" asp-action="SubmitRentalPayment" asp-route-bookingId="@item.BookingId" class="btn btn-outline-success btn-sm fw-bold">ชำระค่าเช่า</a>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-folder-open fa-2x mb-2 d-block"></i> ยังไม่มีประวัติการจองรถในระบบ
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>