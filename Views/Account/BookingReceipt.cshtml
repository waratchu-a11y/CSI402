@model warat_0583_l005.Models.BookingModel
@inject warat_0583_l005.Models.Csi402dbContext Database
@{
    ViewData["Title"] = "รายละเอียดการจอง";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    var payments = Database.Payments.Where(payment => payment.BookingId == Model.BookingId).OrderBy(payment => payment.CreatedAt).ToList();
}

<div class="container my-5">
    <div class="row justify-content-center"><div class="col-lg-9">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white p-4">
                <h2 class="fw-bold mb-1">รายละเอียดการจอง #@Model.BookingId</h2>
                <p class="mb-0">สถานะ: @Model.BookingStatus</p>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6"><strong>รถ:</strong> @Model.CarModel</div>
                    <div class="col-md-6"><strong>ผู้จอง:</strong> @Model.UserId</div>
                    <div class="col-md-6"><strong>สถานที่รับ:</strong> @Model.PickupLocation</div>
                    <div class="col-md-6"><strong>สถานที่คืน:</strong> @Model.ReturnLocation</div>
                    <div class="col-md-6"><strong>รับ:</strong> @Model.PickupDate @Model.PickupTime</div>
                    <div class="col-md-6"><strong>คืน:</strong> @Model.ReturnDate?.ToString("yyyy-MM-dd") @Model.ReturnTime</div>
                    <div class="col-md-6"><strong>จำนวนวัน:</strong> @Model.RentalDays</div>
                    <div class="col-md-6"><strong>บริการเสริม:</strong> @(Model.HasInsurance ? "ประกันภัย " : "")@(Model.HasBabySeat ? "คาร์ซีท" : "")</div>
                    <div class="col-md-6"><strong>ส่วนลด:</strong> ฿@Model.DiscountAmount.ToString("N2") @(Model.PromotionCode is null ? "" : $"({Model.PromotionCode})")</div>
                    <div class="col-md-6"><strong>ยอดค่าเช่า:</strong> ฿@Model.TotalPrice.ToString("N2")</div>
                    <div class="col-md-6"><strong>เงินมัดจำ 10%:</strong> ฿@Model.DepositAmount.ToString("N2")</div>
                    <div class="col-md-6"><strong>สถานะใบขับขี่:</strong> @Model.LicenseStatus</div>
                </div>
                <h5 class="fw-bold mt-4">ประวัติชำระเงิน</h5>
                <div class="table-responsive"><table class="table table-sm">
                    <thead><tr><th>วันเวลา</th><th>ประเภท</th><th>ยอด</th><th>สถานะ</th><th>หลักฐาน</th></tr></thead>
                    <tbody>
                    @foreach (var payment in payments)
                    {
                        <tr>
                            <td>@payment.CreatedAt.ToString("g")</td><td>@payment.PaymentType</td><td>฿@payment.Amount.ToString("N2")</td><td>@payment.PaymentStatus</td>
                            <td>@if (payment.ProofFileName is not null) { <a asp-controller="Payment" asp-action="Proof" asp-route-paymentId="@payment.PaymentId">ดูสลิป</a> }</td>
                        </tr>
                    }
                    @if (payments.Count == 0) { <tr><td colspan="5" class="text-muted text-center">ยังไม่มีรายการชำระเงิน</td></tr> }
                    </tbody>
                </table></div>
                <div class="d-flex gap-2">
                    <a asp-controller="Home" asp-action="MyBookings" class="btn btn-outline-secondary">กลับประวัติการจอง</a>
                    @if (Model.BookingStatus is "pending_payment" or "payment_rejected")
                    {
                        <a asp-controller="Payment" asp-action="SubmitDeposit" asp-route-bookingId="@Model.BookingId" class="btn btn-success">ส่งหลักฐานมัดจำ</a>
                    }
                </div>
            </div>
        </div>
    </div></div>
</div>
