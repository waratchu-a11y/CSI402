@model warat_0583_l005.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "เข้าสู่ระบบ (Login)";
    // 📌 บังคับใช้ Layout ฝั่งลูกค้า เพื่อซ่อนแถบเมนูดำของแอดมิน
    Layout = "~/Views/Shared/_CustomerLayout.cshtml"; 
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <!-- การ์ดเข้าสู่ระบบดีไซน์พรีเมียม -->
            <div class="card shadow-lg border-0" style="border-radius: 20px; overflow: hidden;">
                <!-- หัวการ์ดสีน้ำเงินไล่ระดับ (Gradient) พร้อมไอคอน -->
                <div class="text-white text-center py-4 px-3" style="background: var(--dr-gradient-brand);">
                    <div class="bg-white bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 54px; height: 54px;">
                        <i class="fa-solid fa-right-to-bracket fs-4"></i>
                    </div>
                    <h3 class="mb-0 fw-bold">เข้าสู่ระบบ</h3>
                    <p class="mb-0 mt-1 text-white-50 small">ยินดีต้อนรับกลับสู่ DriverRent คืนความสุขทุกการเดินทาง</p>
                </div>
                
                <div class="card-body p-4 p-md-5 bg-white">
                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-danger rounded-3 small py-2">
                            <i class="fa-solid fa-triangle-exclamation me-1"></i> @ViewBag.ErrorMessage
                        </div>
                    }

                    <form asp-controller="Account" asp-action="Login" method="post">
                        <div class="row g-3">
                            <!-- Username -->
                            <div class="col-12">
                                <label class="form-label fw-bold text-secondary small">ชื่อผู้ใช้งาน (Username)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0" style="border-radius: 12px 0 0 12px;"><i class="fa-solid fa-user text-primary"></i></span>
                                    <input type="text" asp-for="Username" class="form-control border-start-0 ps-0 shadow-none" placeholder="กรอกชื่อผู้ใช้ของคุณ" style="border-radius: 0 12px 12px 0;" required />
                                </div>
                            </div>

                            <!-- Password -->
                            <div class="col-12">
                                <label class="form-label fw-bold text-secondary small">รหัสผ่าน (Password)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0" style="border-radius: 12px 0 0 12px;"><i class="fa-solid fa-lock text-primary"></i></span>
                                    <input type="password" asp-for="Password" class="form-control border-start-0 ps-0 shadow-none" placeholder="กรอกรหัสผ่านของคุณ" style="border-radius: 0 12px 12px 0;" required />
                                </div>
                            </div>

                            <!-- ปุ่มควบคุม -->
                            <div class="col-12 mt-4">
                                <div class="d-grid gap-2">
                                    <button type="submit" class="btn btn-primary btn-lg fw-bold shadow-sm py-2" style="border-radius: 12px; transition: all 0.3s;">
                                        <i class="fa-solid fa-right-to-bracket me-1"></i> เข้าสู่ระบบ
                                    </button>
                                    <a asp-controller="Account" asp-action="Register" class="btn btn-light border text-muted fw-bold py-2" style="border-radius: 12px;">
                                        <i class="fa-solid fa-user-plus me-1"></i> ยังไม่มีบัญชี? สมัครสมาชิก
                                    </a>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* เพิ่มลูกเล่น Effect เมื่อเอาเมาส์ชี้ปุ่มเข้าสู่ระบบ */
    .btn-primary:hover {
        background-color: #0b5ed7 !important;
        transform: translateY(-2px);
        box-shadow: 0 6px 15px rgba(13, 110, 253, 0.3);
    }
    .form-control:focus {
        border-color: #0d6efd;
        box-shadow: none;
    }
</style>