@model warat_0583_l005.ViewModels.LabUserViewModel

@{
    ViewData["Title"] = "แบบฟอร์มจองรถเช่า";
    // 📌 เติมบรรทัดนี้ลงไป เพื่อดึง Layout ของลูกค้ามาครอบ (แถบดำแอดมินจะหายไปทันที)
    Layout = "~/Views/Shared/_CustomerLayout.cshtml"; 
}

<h2>ฟอร์มจองรถเช่า (Lab 5)</h2>

<form asp-action="Lab5" asp-controller="Account" method="post" class="mt-3">
    <div class="mb-3">
        <label class="form-label">ชื่อผู้จอง / UserId</label>
        <input type="text" asp-for="UserId" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">รุ่นรถที่ต้องการจอง</label>
        <input type="text" asp-for="CarModel" class="form-control" placeholder="เช่น Honda Civic" required />
    </div>
    <div class="mb-3">
        <label class="form-label">สถานที่รับรถ</label>
        <input type="text" asp-for="PickupLocation" class="form-control" placeholder="เช่น สนามบินดอนเมือง" required />
    </div>
    <div class="mb-3">
        <label class="form-label">วันที่รับรถ</label>
        <input type="date" asp-for="PickupDate" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">จำนวนวันที่เช่า (วัน)</label>
        <input type="number" asp-for="RentalDays" class="form-control" min="1" value="1" required />
    </div>
    <div class="mb-3">
        <label class="form-label">ราคาเช่าต่อวัน (บาท)</label>
        <input type="number" step="0.01" asp-for="PricePerDay" class="form-control" placeholder="1200" required />
    </div>
    <button type="submit" class="btn btn-primary">ยืนยันการจอง</button>
</form>