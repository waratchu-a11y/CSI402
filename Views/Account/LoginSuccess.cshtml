@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>เข้าสู่ระบบสำเร็จ</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <div class="container min-vh-100 d-flex justify-content-center align-items-center">
        <div class="col-md-6 col-lg-5 text-center">
            <div class="card shadow border-0 p-4">
                <div class="card-body">
                    <div class="mb-3">
                        <h2 class="text-success mt-2 fw-bold">🎉 เข้าสู่ระบบสำเร็จ!</h2>
                    </div>
                    <p class="fs-5">ยินดีต้อนรับคุณ <strong class="text-primary">@ViewBag.Username</strong> เข้าสู่ระบบ</p>
                    <hr />
                    <div class="d-grid gap-2 mt-4">
                        <a asp-controller="Account" asp-action="UserList" class="btn btn-primary btn-lg">ดูรายการผู้ใช้งาน</a>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-danger">ออกจากระบบ</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>