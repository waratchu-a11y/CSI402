@{
    ViewData["Title"] = "ยืนยันรหัส OTP";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml"; 
}

<div class="container mt-5" style="max-width: 450px;">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <h3 class="text-center mb-3">ยืนยันรหัส OTP</h3>
            <p class="text-muted text-center small mb-4">
                ระบบได้ส่งรหัส OTP 6 หลัก ไปยังอีเมลของคุณเรียบร้อยแล้ว<br />
                กรุณาตรวจสอบกล่องข้อความ (Inbox หรือ จดหมายขยะ/Spam)
            </p>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger text-center mb-3" role="alert">
                    @ViewBag.Error
                </div>
            }

            <form asp-action="VerifyOtp" asp-controller="Account" method="post">
                <!-- ส่งค่า Username แอบไปกับฟอร์มเพื่อให้ Controller รู้ว่าใครกำลังยืนยัน OTP -->
                <input type="hidden" name="username" value="@ViewBag.Username" />

                <div class="mb-4">
                    <label class="form-label fw-bold">กรอกรหัส OTP 6 หลัก</label>
                    <input type="text" 
                           name="otp" 
                           class="form-control text-center fs-3 font-monospace" 
                           maxlength="6" 
                           placeholder="000000" 
                           required 
                           autofocus 
                           autocomplete="off" />
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">ยืนยันตัวตน</button>

                <div class="text-center mt-3">
                    <a asp-action="Register" class="text-decoration-none small text-secondary">← ย้อนกลับไปหน้าสมัครสมาชิก</a>
                </div>
            </form>
        </div>
    </div>
</div>