@model warat_0583_l005.Models.UserModel

@{
    ViewData["Title"] = "Edit User";
}

<div class="container d-flex justify-content-center align-items-center mt-5">
    <div class="card shadow-sm" style="width: 100%; max-width: 500px; border-radius: 1rem;">
        <div class="card-body p-4">
            <h3 class="fw-bold text-center mb-4 text-primary">แก้ไขข้อมูลผู้ใช้</h3>
            
            <form asp-controller="Account" asp-action="EditUser" method="post">
                <!-- ซ่อน Id ไว้เพื่อให้อัปเดตถูกคน -->
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="RegisterDate" />

                <div class="mb-3">
                    <label asp-for="Username" class="form-label fw-bold">Username</label>
                    <input type="text" asp-for="Username" class="form-control bg-light" readonly />
                </div>
                
                <div class="mb-3">
                    <label class="form-label fw-bold" for="newPassword">รหัสผ่านใหม่ (เว้นว่างหากไม่เปลี่ยน)</label>
                    <input id="newPassword" name="Password" type="password" class="form-control" autocomplete="new-password" />
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-bold">Email</label>
                    <input type="email" asp-for="Email" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Phone" class="form-label fw-bold">Phone</label>
                    <input type="text" asp-for="Phone" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Gender" class="form-label fw-bold">Gender</label>
                    <select asp-for="Gender" class="form-select">
                        <option value="ชาย">ชาย</option>
                        <option value="หญิง">หญิง</option>
                        <option value="ไม่ระบุ">ไม่ระบุ</option>
                    </select>
                </div>
                
                <div class="d-flex justify-content-between mt-4">
                    <a href="~/Account/UserList" class="btn btn-secondary px-4">ยกเลิก</a>
                    <button type="submit" class="btn btn-primary px-4">บันทึกข้อมูล</button>
                </div>
            </form>
        </div>
    </div>
</div>