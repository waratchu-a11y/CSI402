@model IEnumerable<warat_0583_l005.Models.BookingModel>
@using warat_0583_l005.Models
@{
    ViewData["Title"] = "งานรับ-คืนรถ";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var latestInspections = (Dictionary<int, CarInspectionModel>)ViewBag.LatestInspections;
    var readyForPickupBookingIds = (HashSet<int>)ViewBag.ReadyForPickupBookingIds;
}

<div class="container py-4 py-lg-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="h2 fw-bold mb-1"><i class="fa-solid fa-clipboard-check text-primary me-2"></i>คิวงานรับ-คืนรถ</h1>
            <p class="text-muted mb-0">ตรวจสอบใบขับขี่ ส่งมอบรถ และตรวจรับรถคืนจากลูกค้า</p>
        </div>
        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 fs-6">
            <i class="fa-solid fa-list-check me-1"></i>ทั้งหมด @Model.Count() รายการ
        </span>
    </div>
    @if (TempData["OperationsMessage"] is string message)
    {
        <div class="alert alert-success">@message</div>
    }
    @foreach (var booking in Model)
    {
        var statusBadge = booking.BookingStatus switch
        {
            "confirmed" => "bg-primary-subtle text-primary",
            "rented" => "bg-info-subtle text-info-emphasis",
            "return_requested" => "bg-warning-subtle text-warning-emphasis",
            _ => "bg-secondary-subtle text-secondary"
        };
        var licenseBadge = booking.LicenseStatus switch
        {
            "approved" => "bg-success-subtle text-success",
            "rejected" => "bg-danger-subtle text-danger",
            _ => "bg-warning-subtle text-warning-emphasis"
        };
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <strong><i class="fa-solid fa-car-side text-primary me-2"></i>Booking #@booking.BookingId — @booking.CarModel</strong>
                <div class="d-flex gap-2 flex-wrap">
                    <span class="badge @statusBadge rounded-pill">@(booking.BookingStatus == "return_requested" ? "ลูกค้าแจ้งคืนรถแล้ว" : booking.BookingStatus)</span>
                    <span class="badge @licenseBadge rounded-pill">ใบขับขี่: @booking.LicenseStatus</span>
                </div>
            </div>
            <div class="card-body">
                <p class="mb-2">ลูกค้า: @booking.UserId | รับ @booking.PickupDate @booking.PickupTime — คืน @booking.ReturnDate?.ToString("yyyy-MM-dd") @booking.ReturnTime</p>
                <a href="@Url.Action("License", "Payment", new { bookingId = booking.BookingId })"
                   data-lightbox-src="@Url.Action("License", "Payment", new { bookingId = booking.BookingId })"
                   data-lightbox-title="ใบขับขี่ — Booking #@booking.BookingId (@booking.UserId)"
                   class="btn btn-sm btn-outline-primary">
                    <i class="fa-solid fa-id-card me-1"></i>ดูรูปใบขับขี่
                </a>
                @if (booking.LicenseStatus == "rejected" && !string.IsNullOrWhiteSpace(booking.LicenseReviewNote))
                {
                    <p class="text-danger mt-2 mb-0">เหตุผลที่ไม่ผ่าน: @booking.LicenseReviewNote</p>
                }
                @if (latestInspections.TryGetValue(booking.BookingId, out var inspection))
                {
                    <p class="text-muted mt-2 mb-0">ผลตรวจล่าสุด: @inspection.InspectionStage, เลขไมล์ @inspection.Mileage กม., น้ำมัน @inspection.FuelLevel%</p>
                }
                @if (booking.BookingStatus == "return_requested")
                {
                    var returnImages = booking.ReturnImagePaths?.Split('|', StringSplitOptions.RemoveEmptyEntries) ?? Array.Empty<string>();
                    <div class="alert alert-info mt-3 mb-0">
                        ลูกค้าแจ้งเลขไมล์คืนรถ @booking.ReturnMileage กม.
                        @if (booking.ReturnSubmittedAt.HasValue)
                        {
                            <span> เมื่อ @booking.ReturnSubmittedAt.Value.ToString("g")</span>
                        }
                        <div class="d-flex flex-wrap gap-2 mt-2">
                            @for (int imageIndex = 0; imageIndex < returnImages.Length; imageIndex++)
                            {
                                <a href="@Url.Action("ReturnPhoto", "Payment", new { bookingId = booking.BookingId, imageIndex })"
                                   data-lightbox-src="@Url.Action("ReturnPhoto", "Payment", new { bookingId = booking.BookingId, imageIndex })"
                                   data-lightbox-title="รูปรถคืนที่ @(imageIndex + 1) — Booking #@booking.BookingId"
                                   class="btn btn-sm btn-outline-dark">
                                    <i class="fa-solid fa-image me-1"></i>ดูรูปที่ @(imageIndex + 1)
                                </a>
                            }
                        </div>
                    </div>
                }

                @if (booking.BookingStatus == "confirmed")
                {
                    @if (booking.LicenseStatus is "pending" or "rejected")
                    {
                        <form asp-action="ReviewLicense" method="post" class="row g-2 align-items-center mt-3">
                            <input type="hidden" name="bookingId" value="@booking.BookingId" />
                            <div class="col-md-6"><input name="note" class="form-control" maxlength="500" placeholder="เหตุผลกรณีไม่ผ่าน" /></div>
                            <div class="col-auto">
                                <button name="approve" value="true" class="btn btn-success">ยืนยันใบขับขี่</button>
                                <button name="approve" value="false" class="btn btn-outline-danger">ปฏิเสธ</button>
                            </div>
                        </form>
                    }
                    @if (booking.LicenseStatus == "approved")
                    {
                        @if (readyForPickupBookingIds.Contains(booking.BookingId))
                        {
                            <form asp-action="Pickup" method="post" class="row g-2 align-items-end mt-3">
                                <input type="hidden" name="bookingId" value="@booking.BookingId" />
                                <div class="col-sm-3"><label class="form-label">เลขไมล์ส่งมอบ</label><input name="mileage" type="number" min="0" class="form-control" required /></div>
                                <div class="col-sm-3"><label class="form-label">น้ำมัน (%)</label><input name="fuelLevel" type="number" min="0" max="100" class="form-control" required /></div>
                                <div class="col-sm-4"><label class="form-label">สภาพ/ตำหนิ</label><input name="conditionNotes" maxlength="2000" class="form-control" /></div>
                                <div class="col-sm-2"><button class="btn btn-primary w-100">บันทึกส่งมอบ</button></div>
                            </form>
                        }
                        else
                        {
                            <div class="alert alert-warning mt-3 mb-0">
                                <i class="fa-solid fa-hourglass-half me-1"></i>
                                รอทีมเซอร์วิสตรวจรถก่อนปล่อย และตรวจให้แน่ใจว่ารถพร้อมใช้งาน
                            </div>
                        }
                    }
                }
                else if (booking.BookingStatus == "return_requested")
                {
                    <div class="alert alert-warning mt-3 mb-0">
                        <i class="fa-solid fa-bell me-1"></i>
                        ตรวจรูปรถและเลขไมล์ที่ลูกค้าส่งมา แล้วตรวจรถจริงก่อนส่งต่อทีมเซอร์วิส
                    </div>
                    <form asp-action="ReceiveReturn" method="post" class="row g-2 align-items-end mt-3">
                        <input type="hidden" name="bookingId" value="@booking.BookingId" />
                        <div class="col-sm-3"><label class="form-label">เลขไมล์ที่พนักงานตรวจ</label><input name="mileage" type="number" min="0" class="form-control" required /></div>
                        <div class="col-sm-2"><label class="form-label">น้ำมัน (%)</label><input name="fuelLevel" type="number" min="0" max="100" class="form-control" required /></div>
                        <div class="col-sm-5"><label class="form-label">หมายเหตุตอนรับรถ</label><input name="conditionNotes" maxlength="2000" class="form-control" /></div>
                        <div class="col-sm-2"><button class="btn btn-warning w-100">รับรถ / ส่งทีมช่าง</button></div>
                    </form>
                }
                else if (booking.BookingStatus == "rented")
                {
                    <div class="alert alert-light mt-3 mb-0">
                        รอลูกค้ากดส่งรถคืนจากหน้าประวัติการจอง เมื่อส่งแล้วรายการจะเข้าคิวทีมช่างตรวจสอบ
                    </div>
                }
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <div class="alert alert-light">ไม่มีรายการนัดรับรถหรือรถที่รอรับคืน</div>
    }
</div>
