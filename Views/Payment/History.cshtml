@model IEnumerable<warat_0583_l005.Models.PaymentModel>
@{
    ViewData["Title"] = "ประวัติการเงิน";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-4 py-lg-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="h2 fw-bold mb-1"><i class="fa-solid fa-receipt text-primary me-2"></i>ประวัติรายการชำระเงิน</h1>
            <p class="text-muted mb-0">รายการธุรกรรมการชำระเงินและคืนเงินทั้งหมดในระบบ</p>
        </div>
        <a asp-action="ReviewQueue" class="btn btn-outline-primary rounded-pill px-4">
            <i class="fa-solid fa-arrow-left me-1"></i>กลับคิวตรวจสอบ
        </a>
    </div>

    <div class="card">
        <div class="card-header fw-bold"><i class="fa-solid fa-list text-primary me-2"></i>รายการทั้งหมด (@Model.Count())</div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="px-4">วันเวลา</th>
                            <th>Booking</th>
                            <th>ประเภท</th>
                            <th>ยอด</th>
                            <th>สถานะ</th>
                            <th>Reference</th>
                            <th class="pe-4">ผู้ตรวจ</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var payment in Model)
                    {
                        var statusBadge = payment.PaymentStatus switch
                        {
                            "verified" => "bg-success-subtle text-success",
                            "pending" => "bg-warning-subtle text-warning-emphasis",
                            "rejected" => "bg-danger-subtle text-danger",
                            _ => "bg-secondary-subtle text-secondary"
                        };
                        <tr>
                            <td class="px-4 text-muted small">@payment.CreatedAt.ToString("g")</td>
                            <td><strong>#@payment.BookingId</strong></td>
                            <td>@payment.PaymentType</td>
                            <td class="fw-bold text-primary">฿@payment.Amount.ToString("N2")</td>
                            <td><span class="badge @statusBadge rounded-pill">@payment.PaymentStatus</span></td>
                            <td>@payment.ReferenceNumber</td>
                            <td class="pe-4">@payment.ReviewedBy</td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">ไม่มีประวัติรายการ</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
