@model warat_0583_l005.Models.BookingModel
@{
    ViewData["Title"] = "ส่งหลักฐานแล้ว";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 text-center overflow-hidden">
                <div class="p-4 text-white" style="background: linear-gradient(135deg, #047857, #10b981);">
                    <div class="bg-white text-success rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm mb-3" style="width: 72px; height: 72px; font-size: 2rem;">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                    <h3 class="fw-bold mb-1">ส่งหลักฐานการโอนเรียบร้อยแล้ว</h3>
                    <p class="text-white-50 mb-0">ระบบได้รับข้อมูลของคุณแล้ว</p>
                </div>
                <div class="card-body p-4 p-md-5">
                    <p class="text-muted mb-2">รายการจอง <strong>#@Model.BookingId</strong> กำลังรอฝ่ายการเงินตรวจสอบความถูกต้อง</p>
                    <div class="bg-light border rounded-3 p-3 mb-4">
                        <span class="text-muted small d-block">ยอดมัดจำที่แจ้งชำระ</span>
                        <span class="fs-3 fw-bold text-primary">฿@Model.DepositAmount.ToString("N2")</span>
                    </div>
                    <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                        <a asp-controller="Home" asp-action="MyBookings" class="btn btn-primary px-4 py-2 fw-semibold">
                            <i class="fa-solid fa-clock-rotate-left me-1"></i> ดูสถานะการจอง
                        </a>
                        <a asp-controller="Home" asp-action="Indexcustomer" class="btn btn-outline-secondary px-4 py-2">
                            <i class="fa-solid fa-house me-1"></i> กลับหน้าแรก
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
